@@ -0,0 +1,170 @@
+import type { Entry, Inventory } from '../../sync/inventory';
+
+// Called before the existing inventory diff, including its five-second cycle.
+// No timer or second inventory store. The service returns bases awaiting reply.
+export let observeWeaponPoison: ((local: Inventory, server: Inventory) => Set<number>) | undefined;
+export function setWeaponPoisonObserver(observer: typeof observeWeaponPoison) { observeWeaponPoison = observer; }
+export let readWeaponPoisonInventory: ((refr: any) => Inventory) | undefined;
+export function setWeaponPoisonInventoryReader(reader: NonNullable<typeof readWeaponPoisonInventory>) { readWeaponPoisonInventory = reader; }
+const correctedPoisonBases = new Set<number>();
+
+export const poisonTrace = (sp: any, event: string, details: unknown) => {
+  if (sp.storage?.['aetheriusWeaponPoisonTrace'] === true)
+    sp.printConsole(`[AETHERIUS poison] ${event} ${JSON.stringify(details)}`);
+};
+
+// PO3 setters retain the ExtraPoison node with a null poison and zero count.
+// InventoryApi.cpp:66-76 serializes that node as 0/0. Canonicalize only this
+// empty coating in the comparison view; never mutate the underlying inventory.
+export function normalizePoisonInventory(inv: Inventory): Inventory {
+  return { entries: inv.entries.map(e => {
+    if (e.poisonId !== 0 && e.poisonCount !== 0) return e;
+    const copy = { ...e }; delete copy.poisonId; delete copy.poisonCount; return copy;
+  }) };
+}
+const projectedPoisonStates = new Map<string, { poisonId: number; count: number }>();
+const poisonAttempts = new Map<string, string>();
+const totals = (entries: Entry[], includePoison: boolean) => {
+  const counts = new Map<string, number>();
+  normalizePoisonInventory({ entries }).entries.forEach(e => {
+    const key = JSON.stringify([e.health, e.enchantmentId, e.maxCharge,
+      !!e.removeEnchantmentOnUnequip, e.soul,
+      ...(includePoison ? [e.poisonId, e.poisonCount] : [])]);
+    counts.set(key, (counts.get(key) ?? 0) + e.count);
+  });
+  return JSON.stringify(Array.from(counts.entries()).sort());
+};
+
+/** In-place projection only. Source: CallNativeApi.cpp:119-171 and
+ * CallNative.cpp:245-286 dispatch registered globals with exact arity.
+ * PO3_SKSEFunctions.psc:129,174,176 in the official enabled Extender mod.
+ * Apply creates ExtraPoison; setters change its pointer/count, without equip.
+ * Missing API, hand, record or instance semantics are UNSUPPORTED, never an
+ * excuse to fall through to AddItemEx for this held base. */
+export function reconcilePoisonGroups(sp: any, refr: any, local: Inventory, server: Inventory,
+  diff: Entry[], blocked: Set<number>, enableCrashProtection: boolean, ignoreWorn: boolean): Set<number> {
+  const handled = new Set(blocked);
+  if (refr.getFormID() !== sp.Game.getPlayer()?.getFormID()) return handled;
+  const bases = new Set([...local.entries, ...server.entries].filter(e => e.poisonId).map(e => e.baseId));
+  correctedPoisonBases.forEach(base => bases.add(base));
+  for (const baseId of Array.from(bases)) {
+    if (blocked.has(baseId)) continue;
+    const before = local.entries.filter(e => e.baseId === baseId);
+    const after = server.entries.filter(e => e.baseId === baseId);
+    const held = before.filter(e => e.worn || e.wornLeft);
+    // Initial inventory creation belongs to the existing maintainer path.
+    // Never call a worn native until that exact local weapon actually exists.
+    if (!held.length) {
+      if (before.length && after.some(e => e.worn || e.wornLeft)) handled.add(baseId);
+      continue;
+    }
+    if (sp.Game.getFormEx(baseId)?.getType() !== sp.FormType.Weapon) continue;
+    handled.add(baseId); correctedPoisonBases.add(baseId);
+    if (sp.Utility.isInMenuMode()) continue;
+    if (totals(before, false) !== totals(after, false)) {
+      poisonTrace(sp, 'UNSUPPORTED-instance-difference', { baseId }); continue;
+    }
+    for (const entry of held) {
+      const left = !!entry.wornLeft, key = `${baseId}:${left ? 'left' : 'right'}`;
+      const target = after.find(e => left ? e.wornLeft : e.worn);
+      // A refusal can retain an unsplit clean server stack. It attests clean
+      // poison for both hands, but cannot select a poisoned ambiguous copy.
+      if (!target && after.some(e => e.poisonId)) {
+        poisonTrace(sp, 'UNSUPPORTED-authoritative-hand', { baseId, left }); continue;
+      }
+      const poisonId = target?.poisonId ?? 0, count = poisonId ? target?.poisonCount ?? 0 : 0;
+      if (!Number.isSafeInteger(count) || count < 0 || (poisonId && count === 0)) {
+        poisonTrace(sp, 'UNSUPPORTED-authoritative-poison', { baseId, left }); continue;
+      }
+      if ((entry.poisonId ?? 0) === poisonId && (entry.poisonCount ?? 0) === count) continue;
+      const attempt = JSON.stringify([entry.poisonId ?? 0, entry.poisonCount ?? 0, poisonId, count]);
+      if (poisonAttempts.get(key) === attempt) continue;
+      const actor = sp.Actor.from(refr);
+      if (!actor || actor.getEquippedObject(left ? 0 : 1)?.getFormID() !== baseId) continue;
+      poisonAttempts.set(key, attempt);
+      const functions: string[] = [];
+      const call = (name: string, ...args: any[]) => {
+        functions.push(name);
+        return sp.callNative('PO3_SKSEFunctions', name, null, actor, ...args);
+      };
+      try {
+        const potion = poisonId ? sp.Potion.from(sp.Game.getFormEx(poisonId)) : null;
+        if (poisonId && !potion) throw new Error('unresolved poison');
+        let ok: boolean;
+        if (!entry.poisonId && poisonId) {
+          ok = call('ApplyPoisonToEquippedWeapon', potion, count, left) === true;
+        } else {
+          ok = call('SetEquippedWeaponPoisonCount', count, left) === true;
+          if (ok && (entry.poisonId ?? 0) !== poisonId)
+            ok = call('SetEquippedWeaponPoison', potion, left) === true;
+        }
+        const actualPoison = call('GetEquippedWeaponPoison', left);
+        const actualCount = call('GetEquippedWeaponPoisonCount', left);
+        const actualId = actualPoison?.getFormID() ?? 0;
+        if (!ok || actualId !== poisonId || actualCount !== count) throw new Error('native result differs');
+        // Later 0/0 nodes compare exactly as absence, and duplicate same-base
+        // entries compare by multiset rather than getDiff's first match.
+        entry.poisonId = poisonId; entry.poisonCount = count;
+        projectedPoisonStates.set(key, { poisonId, count });
+        poisonTrace(sp, 'correct-in-place', { baseId, left,
+          before: JSON.parse(attempt).slice(0, 2), after: [actualId, actualCount], functions });
+      } catch (error) {
+        poisonTrace(sp, 'UNSUPPORTED-poison-native', { baseId, left, functions, reason: String(error) });
+      }
+    }
+    // Hand and poison are the only supported delta. This base stays excluded
+    // from reconstruction even on failure; all other bases keep their path.
+    if (ignoreWorn && totals(before, true) !== totals(after, true))
+      poisonTrace(sp, 'UNSUPPORTED-nonworn-poison-difference', { baseId });
+  }
+  return handled;
+}
+
+export class WeaponPoisonClient {
+  private pending?: { id: string; weaponId: number; poisonId: number; at: number };
+  private observed = new Map<string, { poisonId: number; count: number }>();
+  private sequence = 0;
+  constructor(private sp: any, private send: (packet: any) => void, private ready: () => boolean) {}
+  reset() { this.pending = undefined; this.observed.clear(); correctedPoisonBases.clear(); poisonAttempts.clear(); projectedPoisonStates.clear(); }
+  observe(local: Inventory, server: Inventory): Set<number> {
+    const blocked = new Set<number>();
+    if (!this.ready()) return blocked;
+    const held = new Set(local.entries.filter(e => e.worn || e.wornLeft).map(e => `${e.baseId}:${e.wornLeft ? 'left' : 'right'}`));
+    Array.from(this.observed.keys()).forEach(key => { if (!held.has(key)) this.observed.delete(key); });
+    for (const e of local.entries) {
+      if (!e.worn && !e.wornLeft) continue;
+      const hand = e.wornLeft ? 'left' : 'right', key = `${e.baseId}:${hand}`;
+      const previous = this.observed.get(key);
+      this.observed.set(key, { poisonId: e.poisonId ?? 0, count: e.poisonCount ?? 0 });
+      const authoritative = server.entries.some(x => x.baseId === e.baseId && x.poisonId === e.poisonId && x.poisonCount);
+      const projected = projectedPoisonStates.get(key);
+      const fromProjection = !!projected && projected.poisonId === e.poisonId && (e.poisonCount ?? 0) <= projected.count;
+      const application = e.poisonId && !authoritative && !fromProjection &&
+        (!previous || previous.poisonId !== e.poisonId || (e.poisonCount ?? 0) > previous.count);
+      if (!this.pending && application && this.sp.Game.getFormEx(e.baseId)?.getType() === this.sp.FormType.Weapon
+        && this.sp.Potion.from(this.sp.Game.getFormEx(e.poisonId))?.isPoison()) {
+        const id = `poison-${Date.now().toString(36)}-${this.sequence++}`;
+        this.pending = { id, weaponId: e.baseId, poisonId: e.poisonId!, at: Date.now() };
+        poisonTrace(this.sp, 'intent', { id, weaponId: e.baseId, poisonId: e.poisonId, hand });
+        // Runtime ids are session-bound evidence only, never saved identities.
+        this.send({ type: 'weaponPoison', id, weaponId: e.baseId, poisonId: e.poisonId, hand });
+      }
+    }
+    if (this.pending && Date.now() - this.pending.at > 10000) {
+      poisonTrace(this.sp, 'UNSUPPORTED-reply-timeout', { id: this.pending.id });
+      this.pending = undefined;
+    }
+    if (this.pending) { blocked.add(this.pending.weaponId); blocked.add(this.pending.poisonId); }
+    return blocked;
+  }
+  receive(p: any) {
+    if (!this.pending || p.id !== this.pending.id || !Number.isSafeInteger(p.result)) return;
+    // This is a snapshot from the authenticated server, replacing the existing
+    // pcInv projection. Native SetInventory still follows its unchanged path.
+    if (!p.inventory || !Array.isArray(p.inventory.entries) || p.inventory.entries.some((e: any) =>
+      !e || !Number.isSafeInteger(e.baseId) || e.baseId < 1 || !Number.isSafeInteger(e.count) || e.count < 0)) return;
+    this.sp.storage['pcInv'] = p.inventory;
+    poisonTrace(this.sp, 'result', { id: p.id, result: p.result });
+    this.pending = undefined;
+  }
+}

diff --git a/client/src/services/services/gameplayGrantService.ts b/client/src/services/services/gameplayGrantService.ts
new file mode 100644
index 0000000000000000000000000000000000000000..179f1905446f7ccf6fc8e22717bbff4d9c503f95
--- /dev/null
+++ b/client/src/services/services/gameplayGrantService.ts
@@ -0,0 +1,224 @@
+import { MsgType } from '../../messages';
+import { ClientListener, CombinedController, Sp } from './clientListener';
+import { WeaponPoisonClient, setWeaponPoisonObserver, readWeaponPoisonInventory, poisonTrace } from './gameplayWeaponPoison';
+
+const channel = 'aetherius.gameplay.grants';
+const maxPacket = 65536;
+const maxItems = 512;
+const token = (s: unknown): s is string => typeof s === 'string' && /^[a-zA-Z0-9_-]{1,96}$/.test(s);
+const exact = (p: any, keys: string[]) => p && typeof p === 'object' && !Array.isArray(p)
+  && Object.keys(p).sort().join('|') === keys.sort().join('|');
+type WireItem = { key: string; plugin: string; localFormId: number; signature: string; action: 'ensure' | 'remove'; owned: boolean };
+type ItemReport = { key: string; signature: string; action: string; status: string };
+type Packet = { [key: string]: any };
+
+/** Completion of calls already made by RemoteServer, not physical engine work.
+ * Optional emitter hook: absence of this service leaves the old flow untouched. */
+export class GameplaySpawnBarrier {
+  readonly id = `${Date.now().toString(36)}-${Math.random().toString(36).slice(2)}-${GameplaySpawnBarrier.sequence++}`;
+  private static sequence = 0;
+  private pending: Set<string>;
+  failed = false;
+  loading = false;
+  constructor(tasks: string[], private changed: () => void) { this.pending = new Set(tasks); }
+  complete(task: string, success = true) { if (!success) this.failed = true; this.pending.delete(task); this.changed(); }
+  require(task: string) { this.pending.add(task); this.changed(); }
+  get done() { return !this.failed && this.pending.size === 0; }
+}
+
+/** The server owns the set; the client supplies presence/application evidence.
+ * Durable ownership is restored only when explicitly attested by the server.
+ * Without that attestation, a perk already present is never claimed or removed. */
+export class GameplayGrantService extends ClientListener {
+  private session?: string;
+  private cycle?: GameplaySpawnBarrier;
+  private challenge?: string;
+  private begun?: string;
+  private readySent = false;
+  private owned = new Set<string>();
+  private protected = new Set<string>();
+  private last?: { id: string; revision: string; content: string; reports: ItemReport[] };
+  private queued?: string;
+  private queuedPacket?: Packet;
+  private generation = 0;
+  private sessions = new Set<string>();
+  private poisonEnabled = false;
+  private poison: WeaponPoisonClient;
+  constructor(private sp: Sp, private controller: CombinedController) {
+    super();
+    if (sp.settings?.['skymp5-client']?.['aetheriusWeaponPoisonTrace'] === true)
+      sp.storage['aetheriusWeaponPoisonTrace'] = true;
+    this.poison = new WeaponPoisonClient(sp, packet => this.send({ ...packet, cycle: this.cycle?.id, challenge: this.challenge }),
+      () => this.poisonEnabled && this.readySent && !!this.cycle?.done);
+    setWeaponPoisonObserver((local, server) => this.poison.observe(local, server));
+    const traceEquip = (event: string, e: import('skyrimPlatform').EquipEvent) => {
+      if (e.actor?.getFormID() === sp.Game.getPlayer()?.getFormID())
+        poisonTrace(sp, event, { baseId: e.baseObj?.getFormID(), type: e.baseObj?.getType(), uniqueId: e.uniqueId });
+    };
+    controller.on('equip', e => traceEquip('equip', e));
+    controller.on('unequip', e => traceEquip('unequip', e));
+    controller.on('update', () => {
+      const player = sp.Game.getPlayer();
+      const serverInventory = sp.storage['pcInv'] as import('../../sync/inventory').Inventory | undefined;
+      if (this.poisonEnabled && player && serverInventory?.entries && readWeaponPoisonInventory)
+        this.poison.observe(readWeaponPoisonInventory(player), serverInventory);
+      if (sp.storage['aetheriusWeaponPoisonTrace'] === true) {
+        if (player) {
+          const snapshot = JSON.stringify(sp.getExtraContainerChanges(player.getFormID()));
+          if (snapshot !== this.poisonTraceSnapshot) { this.poisonTraceSnapshot = snapshot; poisonTrace(sp, 'extra-changes', JSON.parse(snapshot)); }
+        }
+      }
+    });
+    controller.emitter.on('gameplaySpawnBegin', e => {
+      this.poison.reset(); this.poisonEnabled = false;
+      this.cycle = new GameplaySpawnBarrier(e.tasks, () => this.tryReady());
+      this.challenge = undefined; this.begun = undefined; this.readySent = false;
+      this.last = undefined; this.queued = undefined; this.queuedPacket = undefined; this.generation++;
+      e.capture(this.cycle); this.tryBegin();
+    });
+    controller.emitter.on('customPacketMessage', e => this.receive(e.message.contentJsonDump));
+    controller.emitter.on('connectionDisconnect', () => this.disconnect());
+    controller.emitter.on('connectionAccepted', () => this.disconnect());
+    controller.emitter.on('gameLoad', e => {
+      if (this.cycle?.loading && e.isCausedBySkyrimPlatform) return;
+      // Unknown/local save loads have no instrumented spawn tasks: invalidate,
+      // announce loading, and leave readiness unavailable until next spawn.
+      if (this.session) {
+        this.cycle = new GameplaySpawnBarrier(['unobserved-load'], () => this.tryReady());
+        this.challenge = undefined; this.begun = undefined; this.readySent = false;
+        this.last = undefined; this.queued = undefined; this.queuedPacket = undefined; this.generation++; this.tryBegin();
+      }
+    });
+  }
+  private disconnect() {
+    this.poison.reset(); this.poisonEnabled = false;
+    this.session = undefined; this.cycle = undefined; this.challenge = undefined;
+    this.begun = undefined; this.readySent = false; this.last = undefined;
+    this.queued = undefined; this.queuedPacket = undefined; this.owned.clear(); this.protected.clear(); this.sessions.clear(); this.generation++;
+  }
+  private send(packet: Packet) {
+    if (!this.session) return;
+    this.controller.emitter.emit('sendMessage', {
+      message: { t: MsgType.CustomPacket, contentJsonDump: JSON.stringify({ channel, v: 1, session: this.session, ...packet }) },
+      reliability: 'reliable'
+    });
+  }
+  private tryBegin() {
+    if (!this.session || !this.cycle || this.begun === this.cycle.id) return;
+    this.begun = this.cycle.id;
+    this.send({ type: 'begin', cycle: this.cycle.id });
+  }
+  private tryReady() {
+    if (!this.session || !this.cycle?.done || !this.challenge || this.readySent) return;
+    this.readySent = true;
+    this.send({ type: 'ready', cycle: this.cycle.id, challenge: this.challenge });
+  }
+  private receive(raw: string) {
+    // UTF-8 can use 3 bytes per UTF-16 unit. Conservatively bound both before parse.
+    if (typeof raw !== 'string' || raw.length > maxPacket || this.sp.encodeUtf8(raw).byteLength > maxPacket) return;
+    let p: Packet;
+    try { p = JSON.parse(raw); } catch { return; }
+    if (!p || p.channel !== channel || p.v !== 1) return;
+    if (p.type === 'hello') {
+      if (!exact(p, ['channel','v','session','type']) || !token(p.session)) return;
+      if (this.sessions.has(p.session) || this.sessions.size >= 256) return;
+      this.sessions.add(p.session);
+      // A new authenticated session may be another character. Restore ownership
+      // only from that character's durable server evidence, never from the old one.
+      this.owned.clear(); this.protected.clear();
+      this.poison.reset(); this.poisonEnabled = false;
+      this.session = p.session; this.challenge = undefined; this.begun = undefined;
+      this.readySent = false; this.last = undefined; this.queued = undefined; this.queuedPacket = undefined; this.generation++;
+      this.tryBegin(); return;
+    }
+    if (p.session !== this.session || p.cycle !== this.cycle?.id) return;
+    if (p.type === 'weaponPoisonCapability' && this.readySent && p.challenge === this.challenge
+      && exact(p, ['channel','v','session','type','cycle','challenge','enabled']) && typeof p.enabled === 'boolean') {
+      this.poisonEnabled = p.enabled; return;
+    }
+    if (p.type === 'weaponPoisonResult' && this.readySent && this.cycle?.done && p.challenge === this.challenge
+      && exact(p, ['channel','v','session','type','cycle','challenge','id','result','inventory'])) {
+      this.poison.receive(p); return;
+    }
+    if (p.type === 'challenge') {
+      if (!exact(p, ['channel','v','session','type','cycle','challenge']) || !token(p.challenge) || this.challenge) return;
+      this.challenge = p.challenge; this.tryReady(); return;
+    }
+    if (p.type !== 'perks' || !this.readySent || !this.cycle?.done || p.challenge !== this.challenge
+      || !exact(p, ['channel','v','session','type','cycle','challenge','id','revision','items']) || !token(p.id)
+      || !exact(p.revision, ['facts','grants','equipment','effects','catalog'])
+      || Object.keys(p.revision).some(k => !Number.isSafeInteger(p.revision[k]) || p.revision[k] < 0)
+      || !Array.isArray(p.items) || p.items.length > maxItems) return;
+    const keys = new Set<string>();
+    if (p.items.some((i: WireItem) => {
+      if (!exact(i, ['key','plugin','localFormId','signature','action','owned'])
+        || typeof i.plugin !== 'string' || !/^[^\x00-\x1f\\/:|]+\.(esm|esp|esl)$/.test(i.plugin)
+        || !Number.isSafeInteger(i.localFormId) || i.localFormId < 1 || i.localFormId > 0xffffff
+        || i.key !== `${i.plugin.toLowerCase()}|${i.localFormId.toString(16).toUpperCase().padStart(6,'0')}`
+        || typeof i.signature !== 'string' || !/^sha256:[a-f0-9]{64}$/.test(i.signature)
+        || !['ensure','remove'].includes(i.action) || typeof i.owned !== 'boolean' || (i.action === 'remove' && !i.owned)
+        || keys.has(i.key)) return true;
+      keys.add(i.key); return false;
+    })) return;
+    const revision = JSON.stringify(p.revision);
+    if (this.last) {
+      const old = JSON.parse(this.last.revision);
+      if (Object.keys(old).some(k => p.revision[k] < old[k])) return;
+      if (p.id === this.last.id) {
+        if (raw === this.last.content) this.ack(p, this.last.reports);
+        return;
+      }
+      // Equal revision retries use a new server request id, with identical items.
+      if (Object.keys(old).every(k => old[k] === p.revision[k]) && JSON.stringify(p.items) !== JSON.stringify(JSON.parse(this.last.content).items)) return;
+    }
+    if (this.queuedPacket) {
+      const queued = this.queuedPacket;
+      if (p.id === queued.id || Object.keys(queued.revision).some(k => p.revision[k] < queued.revision[k])) return;
+      if (Object.keys(queued.revision).every(k => p.revision[k] === queued.revision[k]) && JSON.stringify(p.items) !== JSON.stringify(queued.items)) return;
+    }
+    this.queued = p.id;
+    this.queuedPacket = p;
+    const generation = this.generation;
+    this.controller.once('update', () => {
+      if (generation !== this.generation || this.queued !== p.id || p.session !== this.session || p.challenge !== this.challenge || !this.cycle?.done) return;
+      this.queued = undefined;
+      this.queuedPacket = undefined;
+      const player = this.sp.Game.getPlayer();
+      if (!player) return;
+      const reports: ItemReport[] = p.items.map((item: WireItem) => {
+        const report = { key: item.key, signature: item.signature, action: item.action, status: 'FAILED' };
+        try {
+          // No runtime index/masking: the engine resolves defining filename + local id.
+          const perk = this.sp.Perk.from(this.sp.Game.getFormFromFile(item.localFormId, item.plugin));
+          if (!perk) { report.status = 'UNRESOLVED'; return report; }
+          const present = player.hasPerk(perk);
+          if (item.action === 'ensure') {
+            if (!item.owned && present && !this.owned.has(item.key)) this.protected.add(item.key);
+            if (!present) {
+              player.addPerk(perk);
+              if (!player.hasPerk(perk)) return report;
+              if (!this.protected.has(item.key)) this.owned.add(item.key);
+            } else if (item.owned && !this.protected.has(item.key)) this.owned.add(item.key);
+            report.status = this.owned.has(item.key) ? 'APPLIED' : 'ALREADY_PRESENT';
+          } else {
+            if (this.protected.has(item.key)) return report;
+            // Restore server-recorded authorship across reconnect/save, never
+            // infer it merely from presence. Removal must be explicitly owned.
+            if (item.owned) this.owned.add(item.key);
+            if (!this.owned.has(item.key)) return report;
+            if (present) player.removePerk(perk);
+            if (player.hasPerk(perk)) return report;
+            this.owned.delete(item.key); report.status = present ? 'REMOVED' : 'ALREADY_ABSENT';
+          }
+        } catch { /* Failed item is returned, never silently skipped. */ }
+        return report;
+      });
+      this.last = { id: p.id, revision, content: raw, reports };
+      this.ack(p, reports);
+    });
+  }
+  private ack(p: Packet, items: ItemReport[]) {
+    this.send({ type: 'ack', cycle: p.cycle, challenge: p.challenge, id: p.id, revision: p.revision, items });
+  }
+  private poisonTraceSnapshot?: string;
+}

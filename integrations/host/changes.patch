+namespace aetherius::combat::ds5a {
+// Accessed only on the server thread. Weak registry never keeps a world alive.
+inline std::map<const WorldState*,std::weak_ptr<Bridge>>& Bridges() {
+  static std::map<const WorldState*,std::weak_ptr<Bridge>> value;return value;
+}
+inline std::shared_ptr<Bridge> FindBridge(const WorldState* world) {
+  const auto i=Bridges().find(world);return i==Bridges().end()?nullptr:i->second.lock();
+}
+inline Settings ReadSettings(const Json& combat) {
+  Settings out;
+  if(!combat.is_object())return out;
+  if(combat.contains("families")) {
+    const auto& rows=combat.at("families");
+    if(!rows.is_object())throw std::invalid_argument("aetheriusCombat.families must be object");
+    for(const auto& item:rows.items()) {
+      const auto family=std::find(FamilyNames.begin(),FamilyNames.end(),item.key());
+      if(family==FamilyNames.end())throw std::invalid_argument("unknown combat family");
+      const auto mode=item.value().get<std::string>();
+      if(mode!="off"&&mode!="shadow"&&mode!="active")throw std::invalid_argument("unknown family mode");
+      out.modes[family-FamilyNames.begin()]=mode=="off"?Mode::Off:mode=="shadow"?Mode::Shadow:Mode::Active;
+    }
+  }
+  if(combat.contains("multipliers")) {
+    const auto& row=combat.at("multipliers");
+    out.pve=Numeric(row.at("pve"),100);out.pvp=Numeric(row.at("pvp"),100);
+  }
+  return out;
+}
+inline bool Enabled(const Settings& s) { for(const auto m:s.modes)if(m!=Mode::Off)return true;return false; }
+inline ds5b::Context ActorContext(const MpActor& actor,const Profile& p,const Catalog& cat) {
+  ds5b::Context x;
+  if(p.perks.perksKnown)x.perks=&p.perks.perks;
+  if(p.identity)x.identity=&*p.identity;
+  for(unsigned i=0;i<SkillNames.size();++i)if(p.skills[i].supported)x.values[x.valueCount++]={SkillNames[i],p.skills[i].value};
+  const auto& av=actor.GetActorValues();
+  const double percents[]={av.healthPercentage,av.magickaPercentage,av.staminaPercentage};
+  constexpr const char* names[]={"Health","Magicka","Stamina"};
+  for(unsigned i=0;i<3;++i) {
+    if(InRange(percents[i],1)) {
+      x.percents[x.percentCount++]={names[i],percents[i]};
+      if(p.maxima[i].supported)x.values[x.valueCount++]={names[i],percents[i]*p.maxima[i].value};
+    }
+  }
+  const auto race=cat.records.find(p.race);
+  if(race!=cat.records.end()&&race->second.supported)x.keywords=&race->second.keywords;
+  x.wornKnown=true;x.hands={0.,0.};
+  const auto& equipment=actor.GetEquipment();
+  if(equipment.leftSpell.value_or(0))x.hands[0]=9.;
+  if(equipment.rightSpell.value_or(0))x.hands[1]=9.;
+  for(const auto& entry:equipment.inv.entries) {
+    if(!entry.count||entry.GetWorn()==Inventory::Worn::None)continue;
+    const auto found=cat.records.find(entry.baseId);
+    if(found==cat.records.end()||!found->second.supported){x.wornKnown=false;x.hands={};continue;}
+    const auto& row=found->second;
+    if(row.kind==Record::Kind::Armor&&x.wornCount<x.worn.size())x.worn[x.wornCount++]=&row.keywords;
+    if(row.kind==Record::Kind::Weapon||row.itemType.supported) {
+      const unsigned hand=entry.GetWorn()==Inventory::Worn::Left?0:1;
+      x.hands[hand]=row.itemType.supported?std::optional<double>(row.itemType.value):std::nullopt;
+    }
+  }
+  return x;
+}
+inline uint32_t AnimationOwner(const MpActor& actor) {
+  if(actor.IsCreatedAsPlayer())return actor.GetFormId();
+  const auto* world=actor.GetParent();if(!world)return 0;
+  const auto found=world->hosters.find(actor.GetFormId());return found==world->hosters.end()?0:found->second;
+}
+struct Sample { uint64_t sequence=0;uint32_t attacker=0,defender=0,source=0;float current=0;Trace trace; };
+struct Buffer {
+  static constexpr size_t Capacity=1024;
+  std::array<Sample,Capacity> samples{};
+  uint64_t hits=0;size_t size=0,next=0;
+  void Add(Sample s) {s.sequence=++hits;samples[next]=s;next=(next+1)%Capacity;if(size<Capacity)++size;}
+  Json Read() const {
+    Json rows=Json::array();
+    for(size_t n=0;n<size;++n) {
+      const auto& s=samples[(next+Capacity-size+n)%Capacity];const auto& t=s.trace;
+      Json rules=Json::array();
+      for(unsigned i=0;i<t.rules.count;++i) {
+        const auto& r=t.rules.steps[i];
+        rules.push_back({{"ruleIndex",r.rule},{"entryPoint",ds5b::EntryNames[static_cast<unsigned>(r.entry)]},
+          {"provenance",r.provenance.data()},{"priority",r.priority},{"defender",r.defender},{"decision",ds5b::DecisionNames[static_cast<unsigned>(r.decision)]},{"before",r.before},{"after",r.after}});
+      }
+      rows.push_back({{"sequence",s.sequence},{"aggressor",s.attacker},{"target",s.defender},{"source",s.source},
+        {"family",FamilyNames[static_cast<unsigned>(t.family)]},{"current",s.current},
+        {"status",t.status==Status::Calculated?"CALCULATED":t.status==Status::Invalid?"INVALID":"UNSUPPORTED"},
+        {"reason",ReasonName(t.reason)},{"candidate",t.status==Status::Calculated?Json(t.candidate):Json(nullptr)},
+        {"attackerRevision",t.attackerRevision},{"defenderRevision",t.defenderRevision},
+        {"weaponBase",t.weaponBase},{"ammoBase",t.ammoBase},{"weaponSkill",t.weaponSkill},{"skillFactor",t.skillFactor},
+        {"armorRating",t.armor},{"recordDamageResist",t.recordDamageResist},{"armorReduction",t.armorReduction},
+        {"blockConfirmed",t.blockConfirmed},{"blockReduction",t.blockReduction},{"globalMultiplier",t.global},{"preDefense",t.preDefense},
+        {"refinementTier",0},{"q16Contribution",0},{"attackerUnsupportedEffects",t.attackerUnsupportedEffects},
+        {"defenderUnsupportedEffects",t.defenderUnsupportedEffects},{"q16Reason","ACTIVE_EFFECT_INSTANCE_MAGNITUDE_UNAVAILABLE"},
+        {"hitIdentity","HOST_RECEIVED_NO_UNIQUENESS_CLAIM"},
+        {"powerConfirmed",t.powerConfirmed},{"powerFactor",t.powerFactor},{"powerSettingMissing",t.powerSettingMissing},
+        {"bashConfirmed",t.bashConfirmed},{"bashDamage","UNSUPPORTED_NO_CERTIFIED_BASH_FORMULA"},{"sneakBonus",0},
+        {"critical",t.critical},{"criticalChancePercent",t.criticalChance},{"criticalComponent",t.criticalComponent},
+        {"criticalBaseMissing",t.criticalBaseMissing},{"rngState",std::to_string(t.rngState)},{"rngRoll",t.rngRoll},{"rngDraws",t.rngDraws},
+        {"attackerUnsupportedPerks",t.attackerUnsupportedPerks},{"defenderUnsupportedPerks",t.defenderUnsupportedPerks},
+        {"attackerUnsupportedRules",t.attackerUnsupportedRules},{"defenderUnsupportedRules",t.defenderUnsupportedRules},
+        {"rules",rules},{"ruleTraceOverflow",t.rules.overflow},{"rulesUnsupported",t.rules.unsupported},{"rulesApplied",t.rules.applied},{"rulesMissingContext",t.rules.missing}});
+    }
+    return {{"capacity",Capacity},{"hits",hits},{"overwritten",hits-size},{"samples",rows}};
+  }
+};
+class Formula final : public IDamageFormula {
+public:
+  Formula(std::unique_ptr<IDamageFormula> current,std::shared_ptr<Bridge> bridge,
+      Settings settings,std::shared_ptr<Buffer> buffer):current(std::move(current)),bridge(std::move(bridge)),settings(settings),buffer(std::move(buffer)),rng((uint64_t(std::random_device{}())<<32)^std::random_device{}()) {}
+  Trace Evaluate(const MpActor& attacker,const MpActor& defender,const HitData& hit) const {
+    Trace t;
+    const auto fail=[&](Reason reason){t.reason=reason;return t;};
+    if(!attacker.IsCreatedAsPlayer())bridge->RequestNpc(attacker.GetFormId());
+    if(!defender.IsCreatedAsPlayer())bridge->RequestNpc(defender.GetFormId());
+    const auto* a=bridge->Get(attacker.GetFormId(),&attacker);
+    const auto* d=bridge->Get(defender.GetFormId(),&defender);
+    if(a)t.attackerRevision=a->revision;
+    if(d)t.defenderRevision=d->revision;
+    const auto cat=bridge->catalog; // one immutable catalog and profile revision per side
+    if(!cat)return fail(bridge->catalogReason);
+    const bool unarmed=hit.source==0x1f4; // host protocol's unarmed sentinel; never persisted
+    const auto found=cat->records.find(hit.source);
+    const Record* weapon=found==cat->records.end()?nullptr:&found->second;
+    t.family=unarmed?Family::Unarmed:weapon&&weapon->ranged?Family::Ranged:Family::Melee;
+    if(!a||!d)return fail(Reason::ProfileAbsent);
+    if((!a->player&&a->npcGeneration && a->npcGeneration!=attacker.GetNpcGeneration())
+      ||(!d->player&&d->npcGeneration && d->npcGeneration!=defender.GetNpcGeneration()))return fail(Reason::ProfileAbsent);
+    if((attacker.NeedsNpcObservation()&&!attacker.IsNpcConfirmed())
+      ||(defender.NeedsNpcObservation()&&!defender.IsNpcConfirmed()))return fail(Reason::ProfileAbsent);
+    if(!a->valid||!d->valid){t.status=Status::Invalid;return fail(Reason::ProfileInvalid);}
+    // Reject stale player projection after disconnect even if the form remains alive.
+    if((a->player&&attacker.GetUserId()==Networking::InvalidUserId)
+        ||(d->player&&defender.GetUserId()==Networking::InvalidUserId))return fail(Reason::ProfileAbsent);
+    t.attackerUnsupportedEffects=a->unsupportedEffects;t.defenderUnsupportedEffects=d->unsupportedEffects;
+    t.attackerUnsupportedPerks=a->perks.unsupported;t.defenderUnsupportedPerks=d->perks.unsupported;
+    t.attackerUnsupportedRules=a->perks.unsupportedRules;t.defenderUnsupportedRules=d->perks.unsupportedRules;
+    const auto& offense=attacker.GetEquipment().inv.entries;
+    const auto& defense=defender.GetEquipment().inv.entries;
+    if(offense.size()>64||defense.size()>64)return fail(Reason::EquipmentCapacity);
+    auto ac=ActorContext(attacker,*a,*cat),dc=ActorContext(defender,*d,*cat);
+    if(weapon&&weapon->kind==Record::Kind::Weapon&&weapon->supported) {ac.keywords=&weapon->keywords;ac.weaponSkill=weapon->skill==Skill::Marksman?"Archery":SkillNames[static_cast<unsigned>(weapon->skill)];}
+    const auto owner=AnimationOwner(attacker);const auto now=std::chrono::steady_clock::now();
+    const auto& evidence=attacker.GetCombatAttackEvidence();
+    t.powerConfirmed=hit.isPowerAttack&&owner&&evidence.Confirm(ds5b::AttackEvidence::Kind::Power,owner,attacker.GetNpcGeneration(),now);
+    t.bashConfirmed=hit.isBashAttack&&owner&&evidence.Confirm(ds5b::AttackEvidence::Kind::Bash,owner,attacker.GetNpcGeneration(),now);
+    unsigned weaponCount=0,ammoCount=0;
+    const Inventory::Entry* weaponEntry=nullptr;
+    NeutralRefinement refinement;
+    if(unarmed) {
+      const auto race=cat->records.find(a->race);
+      if(race==cat->records.end()||race->second.kind!=Record::Kind::Race||!race->second.supported)return fail(Reason::RaceAbsent);
+      t.weaponBase=race->second.base;
+    }else {
+      if(!weapon)return fail(Reason::RecordAbsent);
+      if(weapon->kind!=Record::Kind::Weapon||!weapon->supported)return fail(Reason::RecordUnsupported);
+      for(const auto& entry:offense) {
+        if(!entry.count||entry.GetWorn()==Inventory::Worn::None)continue;
+        if(entry.baseId==hit.source){++weaponCount;weaponEntry=&entry;}
+        if(weapon->ranged) {
+          const auto row=cat->records.find(entry.baseId);
+          if(row!=cat->records.end()&&row->second.kind==Record::Kind::Ammo) {
+            if(!row->second.supported)return fail(Reason::RecordUnsupported);
+            ++ammoCount;t.ammoBase=row->second.base;
+          }
+        }
+      }
+      if(!weaponCount)return fail(Reason::SourceNotEquipped);
+      if(weaponCount>1||ammoCount>1)return fail(Reason::AmbiguousEquipment);
+      if(weapon->ranged&&!ammoCount)return fail(Reason::AmmoAbsent);
+      const auto skill=a->skills[static_cast<unsigned>(weapon->skill)];
+      if(!skill.supported)return fail(Reason::SkillAbsent);
+      t.weaponSkill=skill.value;t.weaponBase=weapon->base;
+    }
+    for(const auto& entry:defense) {
+      if(!entry.count||entry.GetWorn()==Inventory::Worn::None)continue;
+      const auto row=cat->records.find(entry.baseId);
+      if(row==cat->records.end())return fail(Reason::RecordAbsent);
+      const auto& rec=row->second;
+      if(rec.kind!=Record::Kind::Armor)continue;
+      if(!rec.supported)return fail(Reason::RecordUnsupported);
+      if(entry.enchantmentId.value_or(0))return fail(Reason::InstanceEnchantment);
+      double skill=0;
+      if(!rec.clothing) {
+        const auto value=d->skills[static_cast<unsigned>(rec.skill)];
+        if(!value.supported)return fail(Reason::SkillAbsent);
+        skill=value.value;
+      }
+      // Flat record ENCH DamageResist is preserved once, outside base scaling/Q16.
+      auto pieceContext=dc;pieceContext.keywords=&rec.keywords;
+      const auto rating=rec.clothing?rec.base:ArmorPiece(rec.base,skill,cat->scaling,refinement.Tier(&entry));
+      t.armor+=std::max(0.,ds5b::Apply(d->perks,ds5b::EP::Armor,rating,pieceContext,ac,t.rules,true));
+      t.recordDamageResist+=rec.damageResist;
+    }
+    t.blockConfirmed=hit.isHitBlocked&&defender.IsBlockActive();
+    if(t.blockConfirmed) {
+      const auto skill=d->skills[static_cast<unsigned>(Skill::Block)];
+      if(!skill.supported)return fail(Reason::SkillAbsent);
+      t.blockReduction=std::clamp(ds5b::Apply(d->perks,ds5b::EP::Block,.20+.003*skill.value,dc,ac,t.rules,true),0.,.85);
+    }
+    t.global=a->player&&d->player?settings.pvp:settings.pve;
+    Finish(t,cat->scaling,refinement.Tier(weaponEntry),unarmed);
+    if(t.status!=Status::Calculated)return t;
+    FinishPerks(t,a->perks,d->perks,ac,dc,weapon?weapon->criticalBase:Value{},cat->powerBonus,rng);
+    return t;
+  }
+  float CalculateDamage(const MpActor& a,const MpActor& d,const HitData& hit) const override {
+    const float applied=current->CalculateDamage(a,d,hit);
+    auto t=Evaluate(a,d,hit);
+    const auto mode=settings.modes[static_cast<unsigned>(t.family)];
+    if(mode==Mode::Off)return applied;
+    // DS-7 must supply actual hit identity and certify two-client application.
+    if(mode==Mode::Active){t.status=Status::Unsupported;t.reason=Reason::ActiveRequiresDS7;}
+    buffer->Add({0,hit.aggressor,hit.target,hit.source,applied,t});
+    return applied;
+  }
+  float CalculateDamage(const MpActor& a,const MpActor& d,const SpellCastData& spell) const override {
+    return current->CalculateDamage(a,d,spell);
+  }
+private:
+  std::unique_ptr<IDamageFormula> current;
+  std::shared_ptr<Bridge> bridge;
+  Settings settings;
+  std::shared_ptr<Buffer> buffer;
+  mutable ds5b::Rng rng;
+};
+inline Json Capabilities(const Settings& settings,const Bridge& bridge) {
+  Json families=Json::object();
+  for(unsigned i=0;i<FamilyNames.size();++i) {
+    const auto mode=settings.modes[i];
+    families[FamilyNames[i]]={{"mode",mode==Mode::Off?"off":mode==Mode::Shadow?"shadow":"active"},
+      {"owner","NATIVE_SERVER"},{"candidateOwner","AETHERIUS_SERVER"},
+      {"status",mode==Mode::Shadow&&bridge.catalog?"SHADOW":"UNSUPPORTED"},
+      {"reason",mode==Mode::Off?"FAMILY_OFF":mode==Mode::Active?"ACTIVE_REQUIRES_DS7":bridge.catalog?"CLASS_COMPILED_PERKS_DS5B":ReasonName(bridge.catalogReason)}};
+  }
+  return {{"version",1},{"families",families},{"recordDamageResist","PRESERVED_ONCE"},
+    {"perks","SUPPORTED_CLASS_COMPILED_ONLY"},{"sneak","DISABLED_Q9"},{"bash","UNSUPPORTED_NO_CERTIFIED_BASH_FORMULA"},{"q16","UNSUPPORTED_ZERO_CONTRIBUTION"},
+    {"magicOwner","NATIVE_SERVER"},{"procsOwner","NATIVE_CLIENT"},{"deduplication","HOST_COOLDOWNS_ONLY_DS7_PENDING"}};
+}
+}
diff --git a/server/cpp/server_guest_lib/aetherius_combat/ds5a/NativeRecords.h b/server/cpp/server_guest_lib/aetherius_combat/ds5a/NativeRecords.h
new file mode 100644
index 0000000000000000000000000000000000000000..9dd21eab0c5dacc95d738d4c3c3f8acb3a91d243
--- /dev/null
+++ b/server/cpp/server_guest_lib/aetherius_combat/ds5a/NativeRecords.h
@@ -0,0 +1,50 @@
+#pragma once
+#include "Bridge.h"
+#include "libespm/espm.h"
+#include "libespm/IterateFields.h"
+#include <cstring>
+namespace aetherius::combat::ds5a {
+// Called once by SetCatalog, never by Evaluate. Winners use source-aware links.
+inline void HydrateNative(Catalog& catalog,const espm::CombineBrowser& browser) {
+  auto& cache=browser.GetCache();
+  const auto source=browser.FindSourceByFilename("Skyrim.esm");
+  if(source) {
+    const auto record=browser.LookupById(browser.ToRuntimeFormId(*source,0x031899));
+    if(const auto gmst=espm::Convert<espm::GMST>(record.rec)) {
+      const double value=gmst->GetData(cache).value;
+      if(InRange(value,100))catalog.powerBonus={true,value};
+    }
+  }
+  for(auto& row:catalog.records) {
+    auto& record=row.second;if(!record.supported)continue;
+    if(record.kind==Record::Kind::Armor) {
+      const auto armo=espm::Convert<espm::ARMO>(browser.LookupById(row.first).rec);
+      if(armo) {const auto data=armo->GetData(cache);if(data.equipSlotId)record.itemType={true,10};}
+      continue;
+    }
+    if(record.kind!=Record::Kind::Weapon)continue;
+    uint32_t id=row.first;std::array<uint32_t,32> visited{};size_t count=0;
+    for(;;) {
+      if(count==visited.size()||std::find(visited.begin(),visited.begin()+count,id)!=visited.begin()+count)break;
+      visited[count++]=id;
+      const auto lookup=browser.LookupById(id);const auto weapon=espm::Convert<espm::WEAP>(lookup.rec);
+      if(!weapon)break;
+      uint32_t parent=0;Value critical;
+      espm::IterateFields_(weapon,[&](const char* type,uint32_t size,const char* data) {
+        if(!std::memcmp(type,"CNAM",4)&&size==4)std::memcpy(&parent,data,4);
+        // CRDT starts with the ushort Critical.Damage; verified against exported winners.
+        if(!std::memcmp(type,"CRDT",4)&&size>=2) {uint16_t damage=0;std::memcpy(&damage,data,2);critical={true,double(damage)};}
+      },cache);
+      if(parent){id=lookup.ToGlobalId(parent);continue;} // Q15a: template base, no enchantment magnitude.
+      record.criticalBase=critical;
+      const auto data=weapon->GetData(cache);
+      if(data.weapDNAM) {
+        const auto type=static_cast<unsigned>(data.weapDNAM->animType);
+        // WEAP anim enum 8=staff,9=crossbow; GetEquippedItemType uses 8=staff,12=crossbow.
+        record.itemType={true,double(type==9?12:type)};
+      }
+      break;
+    }
+  }
+}
+}
diff --git a/server/cpp/server_guest_lib/aetherius_combat/ds5a/Physical.h b/server/cpp/server_guest_lib/aetherius_combat/ds5a/Physical.h
new file mode 100644
index 0000000000000000000000000000000000000000..2041300b097935389ffc9238881a7166dd9e2a57
--- /dev/null
+++ b/server/cpp/server_guest_lib/aetherius_combat/ds5a/Physical.h
@@ -0,0 +1,126 @@
+#pragma once
+// DS-5a/DS-5b: bounded arithmetic and compiled rules, without another actor store.
+#include "Rules.h"
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+
+namespace aetherius::combat::ds5a {
+enum class Status { Calculated, Unsupported, Invalid };
+enum class Reason { None, CatalogAbsent, CatalogInvalid, ProfileAbsent, ProfileInvalid,
+  SkillAbsent, RecordAbsent, RecordUnsupported, EquipmentCapacity, SourceNotEquipped,
+  AmbiguousEquipment, AmmoAbsent, RaceAbsent, InstanceEnchantment, NumericInvalid,
+  ActiveRequiresDS7 };
+inline const char* ReasonName(Reason r) {
+  constexpr const char* names[] = {"NONE","CATALOG_ABSENT","CATALOG_INVALID","PROFILE_ABSENT",
+    "PROFILE_INVALID","SKILL_UNSUPPORTED","RECORD_ABSENT","RECORD_UNSUPPORTED","EQUIPMENT_CAPACITY",
+    "SOURCE_NOT_EQUIPPED","AMBIGUOUS_EQUIPMENT","AMMO_ABSENT","RACE_UNSUPPORTED",
+    "INSTANCE_ENCHANTMENT_UNSUPPORTED","NUMERIC_INVALID","ACTIVE_REQUIRES_DS7"};
+  return names[static_cast<unsigned>(r)];
+}
+enum class Skill : unsigned { OneHanded, TwoHanded, Marksman, Block, HeavyArmor, LightArmor, None };
+inline constexpr std::array<const char*,6> SkillNames = {"OneHanded","TwoHanded","Marksman","Block","HeavyArmor","LightArmor"};
+enum class Family : unsigned { Melee, Ranged, Unarmed };
+inline constexpr std::array<const char*,3> FamilyNames = {"melee","ranged","unarmed"};
+enum class Mode { Off, Shadow, Active };
+struct Settings {
+  std::array<Mode,3> modes{Mode::Off,Mode::Off,Mode::Off};
+  double pve = 1, pvp = 1;
+};
+struct Scaling { double weaponMax = 0, armorBase = 0, armorMax = 0; };
+inline bool InRange(double v, double max = 1e7) { return std::isfinite(v) && v >= 0 && v <= max; }
+struct Value { bool supported = false; double value = 0; };
+struct Profile {
+  uint64_t revision = 0;
+  uint64_t npcGeneration = 0;
+  bool valid = false, player = false;
+  uint32_t race = 0;
+  std::array<Value,6> skills{};
+  uint16_t unsupportedEffects = 0;
+  ds5b::Table perks;
+  std::array<Value,3> maxima{};
+  std::optional<StableFormKey> identity;
+};
+struct Trace {
+  Status status = Status::Unsupported;
+  Reason reason = Reason::ProfileAbsent;
+  Family family = Family::Melee;
+  uint64_t attackerRevision = 0, defenderRevision = 0;
+  uint16_t attackerUnsupportedEffects = 0, defenderUnsupportedEffects = 0;
+  double weaponBase = 0, ammoBase = 0, weaponSkill = 0, skillFactor = 1;
+  double armor = 0, recordDamageResist = 0, armorReduction = 0, blockReduction = 0;
+  double global = 1, preDefense = 0, candidate = 0;
+  bool blockConfirmed = false;
+  bool powerConfirmed=false,bashConfirmed=false,critical=false,criticalBaseMissing=false,powerSettingMissing=false;
+  double powerFactor=1,criticalChance=0,criticalComponent=0,normal=0,rngRoll=0;
+  uint64_t rngState=0;
+  unsigned rngDraws=0;
+  ds5b::Audit rules;
+  unsigned attackerUnsupportedPerks=0,defenderUnsupportedPerks=0;
+  unsigned attackerUnsupportedRules=0,defenderUnsupportedRules=0;
+};
+// Instance identity is deliberately opaque; production installs tier zero only.
+class RefinementTierProvider {
+public:
+  virtual ~RefinementTierProvider() = default;
+  virtual unsigned Tier(const void* equippedInstance) const = 0;
+};
+class NeutralRefinement final : public RefinementTierProvider {
+public:
+  unsigned Tier(const void*) const override { return 0; }
+};
+inline double RefinementFactor(unsigned tier) { return tier <= 3 ? 1 + .25*tier : NAN; }
+inline double ArmorCurve(double rating) {
+  return rating <= 500 ? rating*.8/500 : rating >= 1000 ? .9 : .8+(rating-500)*.1/500;
+}
+inline double ArmorPiece(double base, double skill, const Scaling& g, unsigned tier = 0) {
+  return base*RefinementFactor(tier)*(1+(g.armorMax-g.armorBase)*skill/100);
+}
+inline double Block(double skill) { return std::min(.85, .20+.003*skill); }
+inline bool Finish(Trace& t, const Scaling& g, unsigned weaponTier, bool unarmed) {
+  if (!InRange(t.weaponBase) || !InRange(t.ammoBase) || !InRange(t.weaponSkill,1000)
+      || !InRange(t.armor) || !InRange(t.recordDamageResist) || !InRange(t.global,100)
+      || !InRange(g.weaponMax,100) || !InRange(g.armorBase,100) || !InRange(g.armorMax,100)
+      || g.weaponMax < 1 || g.armorMax < g.armorBase || weaponTier > 3
+      || !InRange(t.blockReduction,.85)) {
+    t.status=Status::Invalid; t.reason=Reason::NumericInvalid; return false;
+  }
+  t.skillFactor=unarmed ? 1 : 1+(g.weaponMax-1)*t.weaponSkill/100;
+  t.normal=(t.weaponBase*RefinementFactor(weaponTier)+t.ammoBase)*t.skillFactor;
+  t.preDefense=t.normal*t.global;
+  t.armorReduction=ArmorCurve(t.armor+t.recordDamageResist);
+  t.candidate=t.preDefense*(1-t.blockReduction)*(1-t.armorReduction);
+  if (!InRange(t.candidate)) { t.status=Status::Invalid;t.reason=Reason::NumericInvalid;return false; }
+  t.status=Status::Calculated;t.reason=Reason::None;return true;
+}
+// Same arithmetic kernel used by host, native tests and golden tests.
+template<class Random>
+inline void FinishPerks(Trace& t,const ds5b::Table& attackPerks,const ds5b::Table& defensePerks,
+    const ds5b::Context& ac,const ds5b::Context& dc,Value criticalBase,Value powerBonus,Random& rng) {
+    // Explicit entry-point stages. Set/Add operate on that stage's actual value.
+    t.normal=ds5b::Apply(attackPerks,ds5b::EP::Attack,t.normal,ac,dc,t.rules);
+    t.normal=ds5b::Apply(attackPerks,ds5b::EP::Weapon,t.normal,ac,dc,t.rules);
+    if(t.powerConfirmed) {
+      if(powerBonus.supported) {
+        t.powerFactor=ds5b::Apply(attackPerks,ds5b::EP::Power,1+powerBonus.value,ac,dc,t.rules);
+        t.normal*=std::max(0.,t.powerFactor);
+      }else t.powerSettingMissing=true;
+    }
+    ds5b::Apply(attackPerks,ds5b::EP::Sneak,1,ac,dc,t.rules); // Always inactive, even if compiled SUPPORTED.
+    t.criticalChance=std::clamp(ds5b::Apply(attackPerks,ds5b::EP::CritChance,t.criticalChance,ac,dc,t.rules),0.,100.);
+    if(t.criticalChance>0) {
+      if(!criticalBase.supported)t.criticalBaseMissing=true;
+      else {
+        t.rngState=rng.state;t.rngRoll=rng.Next();t.rngDraws=1;t.critical=t.rngRoll<t.criticalChance/100;
+        if(t.critical)t.criticalComponent=std::max(0.,ds5b::Apply(attackPerks,ds5b::EP::CritDamage,criticalBase.value,ac,dc,t.rules));
+      }
+    }
+    t.preDefense=(std::max(0.,t.normal)+t.criticalComponent)*t.global;
+    t.preDefense=std::max(0.,ds5b::Apply(defensePerks,ds5b::EP::Incoming,t.preDefense,dc,ac,t.rules,true));
+    const double rating=std::max(0.,ds5b::Apply(attackPerks,ds5b::EP::TargetArmor,t.armor+t.recordDamageResist,ac,dc,t.rules));
+    t.armorReduction=ArmorCurve(rating);
+    t.candidate=t.preDefense*(1-t.blockReduction)*(1-t.armorReduction);
+    if(t.rules.invalid||!InRange(t.candidate)){t.status=Status::Invalid;t.reason=Reason::NumericInvalid;}
+}
+}
diff --git a/server/cpp/server_guest_lib/aetherius_combat/ds5a/Rules.h b/server/cpp/server_guest_lib/aetherius_combat/ds5a/Rules.h
new file mode 100644
index 0000000000000000000000000000000000000000..e5c75fd2d41788c9ba23336b4ad03af6f2138edc
--- /dev/null
+++ b/server/cpp/server_guest_lib/aetherius_combat/ds5a/Rules.h
@@ -0,0 +1,249 @@
+#pragma once
+// DS-5b. Conversion only at publication; evaluation has no JSON, I/O or allocation.
+#include "../forms/StableFormKey.h"
+#include <nlohmann/json.hpp>
+#include <array>
+#include <cmath>
+#include <cstring>
+#include <optional>
+#include <string_view>
+#include <vector>
+
+namespace aetherius::combat::ds5b {
+using Json = nlohmann::json;
+enum class EP : unsigned { Attack, Weapon, Power, Sneak, CritChance, CritDamage, Incoming, TargetArmor, Armor, Block, Count };
+inline constexpr std::array<const char*,10> EntryNames={"ModAttackDamage","CalculateWeaponDamage","ModPowerAttackDamage","ModSneakAttackMult",
+  "CalculateMyCriticalHitChance","CalculateMyCriticalHitDamage","ModIncomingDamage","ModTargetDamageResistance","ModArmorRating","ModPercentBlocked"};
+inline EP Entry(std::string_view name) {
+  for(unsigned i=0;i<EntryNames.size();++i)if(name==EntryNames[i])return static_cast<EP>(i);
+  return EP::Count;
+}
+enum class Decision : unsigned { Applied, False, Missing, Unsupported, Operation, Disabled, Invalid, Order };
+inline constexpr const char* DecisionNames[]={"APPLIED","CONDITION_FALSE","CONDITION_CONTEXT_UNAVAILABLE","PROFILE_RULE_UNSUPPORTED",
+  "OPERATION_OR_AV_UNSUPPORTED","SNEAK_DISABLED_Q9","NUMERIC_INVALID","NONCOMMUTATIVE_PRIORITY_UNCERTIFIED"};
+struct Condition {
+  std::string function, compare, actorValue;
+  std::optional<StableFormKey> key;
+  double expected=0;
+  bool target=false;
+};
+using Clause=std::vector<Condition>;
+using Tab=std::vector<Clause>;
+struct Rule {
+  EP entry=EP::Count;
+  StableFormKey perk;
+  std::string modification,actorValue,sourceKey,reason;
+  double value=0,priority=0;
+  unsigned rank=0,effectIndex=0,index=0;
+  bool supported=false,orderUncertified=false;
+  std::array<char,256> provenance{};
+  std::vector<Tab> tabs;
+};
+struct Table {
+  std::array<std::vector<Rule>,10> rules;
+  std::vector<StableFormKey> perks;
+  bool perksKnown=false;
+  unsigned unsupported=0,unsupportedRules=0;
+};
+struct Number { std::string_view name; double value; };
+struct Context {
+  const std::vector<StableFormKey>* keywords=nullptr;
+  const std::vector<StableFormKey>* perks=nullptr;
+  const StableFormKey* identity=nullptr;
+  std::string_view weaponSkill;
+  std::array<const std::vector<StableFormKey>*,64> worn{};
+  size_t wornCount=0;
+  bool wornKnown=false;
+  std::array<Number,16> values{}, percents{};
+  size_t valueCount=0,percentCount=0;
+  std::array<std::optional<double>,2> hands{}; // Left, Right; absent differs from empty (0)
+  std::optional<double> Value(std::string_view key,bool percent=false) const {
+    const auto& rows=percent?percents:values;const auto count=percent?percentCount:valueCount;
+    // Compiler calls the weapon AV Archery; fixed profile calls it Marksman.
+    if(key=="Archery")key="Marksman";
+    for(size_t i=0;i<count;++i)if(rows[i].name==key&&std::isfinite(rows[i].value))return rows[i].value;
+    return {};
+  }
+};
+inline bool Contains(const std::vector<StableFormKey>& rows,const StableFormKey& key) {
+  return std::find(rows.begin(),rows.end(),key)!=rows.end();
+}
+inline std::optional<double> ConditionValue(const Condition& c,const Context& x) {
+  if(c.function=="HasKeyword")return x.keywords&&c.key?std::optional<double>(Contains(*x.keywords,*c.key)):std::nullopt;
+  if(c.function=="HasPerk")return x.perks&&c.key?std::optional<double>(Contains(*x.perks,*c.key)):std::nullopt;
+  if(c.function=="GetIsID")return x.identity&&c.key?std::optional<double>(*x.identity==*c.key):std::nullopt;
+  if(c.function=="WornHasKeyword"||c.function=="WornApparelHasKeywordCount") {
+    if(!x.wornKnown||!c.key)return {};
+    double count=0;for(size_t i=0;i<x.wornCount;++i)if(Contains(*x.worn[i],*c.key))++count;
+    return c.function=="WornHasKeyword"?double(count>0):count;
+  }
+  if(c.function=="GetEquippedItemType") {
+    if(c.actorValue=="Left")return x.hands[0];if(c.actorValue=="Right")return x.hands[1];return {};
+  }
+  if(c.function=="IsWeaponSkillType")return x.weaponSkill.empty()?std::nullopt:std::optional<double>(x.weaponSkill==c.actorValue);
+  if(c.function=="GetActorValue")return x.Value(c.actorValue);
+  if(c.function=="GetActorValuePercent")return x.Value(c.actorValue,true);
+  return {};
+}
+inline bool Compare(double v,const std::string& op,double expected) {
+  if(op=="EqualTo")return v==expected;if(op=="NotEqualTo")return v!=expected;
+  if(op=="GreaterThan")return v>expected;if(op=="GreaterThanOrEqualTo")return v>=expected;
+  if(op=="LessThan")return v<expected;if(op=="LessThanOrEqualTo")return v<=expected;
+  return false;
+}
+inline Decision Matches(const Rule& rule,const Context* subject,const Context* target) {
+  if(!rule.supported)return Decision::Unsupported;
+  bool failed=false,missing=false;
+  for(const auto& tab:rule.tabs)for(const auto& clause:tab) {
+    bool any=false,unknown=false;
+    for(const auto& c:clause) {
+      const auto* x=c.target?target:subject;
+      const auto value=x?ConditionValue(c,*x):std::nullopt;
+      if(!value||!std::isfinite(*value)){unknown=true;continue;}
+      if(Compare(*value,c.compare,c.expected))any=true;
+    }
+    if(!any){failed=true;missing|=unknown;}
+  }
+  return failed?(missing?Decision::Missing:Decision::False):Decision::Applied;
+}
+struct Step {
+  unsigned rule=0;
+  EP entry=EP::Count;
+  Decision decision=Decision::False;
+  bool defender=false;
+  double before=0,after=0;
+  double priority=0;
+  std::array<char,256> provenance{};
+};
+struct Audit {
+  std::array<Step,48> steps{};
+  unsigned count=0,overflow=0,applied=0,missing=0,unsupported=0;
+  bool invalid=false;
+  void Add(const Rule& rule,Decision decision,double before,double after,bool defender) {
+    if(count<steps.size())steps[count++]={rule.index,rule.entry,decision,defender,before,after,rule.priority,rule.provenance};else ++overflow;
+    applied+=decision==Decision::Applied;missing+=decision==Decision::Missing;
+    unsupported+=decision==Decision::Unsupported||decision==Decision::Operation||decision==Decision::Order;
+    invalid|=decision==Decision::Invalid;
+  }
+};
+// Operations modify the current entry-point value. Uncertified noncommuting groups are withheld at publication.
+inline std::optional<double> Operate(const Rule& r,double current,const Context& subject) {
+  if(r.modification=="Set")return r.value;
+  if(r.modification=="Add")return current+r.value;
+  if(r.modification=="Multiply")return current*r.value;
+  const auto av=subject.Value(r.actorValue);if(!av)return {};
+  if(r.modification=="MultiplyOnePlusAVMult")return current*(1+r.value**av);
+  if(r.modification=="MultiplyAVMult")return current*r.value**av;
+  if(r.modification=="AddAVMult"||r.modification=="AddActorValueMult")return current+r.value**av;
+  return {};
+}
+inline double Apply(const Table& table,EP ep,double value,const Context& subject,const Context& target,Audit& audit,bool defender=false) {
+  for(const auto& rule:table.rules[static_cast<unsigned>(ep)]) {
+    auto decision=ep==EP::Sneak?Decision::Disabled:rule.orderUncertified?Decision::Order:Matches(rule,&subject,&target);
+    const double before=value;
+    if(decision==Decision::Applied) {
+      const auto next=Operate(rule,value,subject);
+      if(!next)decision=Decision::Operation;
+      else if(!std::isfinite(*next)||std::abs(*next)>1e7)decision=Decision::Invalid;
+      else value=*next;
+    }
+    audit.Add(rule,decision,before,value,defender);
+  }
+  return value;
+}
+inline StableFormKey Form(const std::string& value) {
+  const auto split=value.find(':');
+  if(split!=6)throw std::invalid_argument("compiled form key");
+  return StableFormKey::Parse(value.substr(7)+":"+value.substr(0,6));
+}
+inline Rule Convert(const Json& j,const StableFormKey& perk,unsigned index) {
+  Rule r;r.perk=perk;r.index=index;r.entry=Entry(j.at("entryPoint").get<std::string>());
+  r.supported=j.at("status")=="SUPPORTED";r.reason=j.value("reason",std::string{});
+  if(!r.supported)return r; // Never parse partial conditions into a usable rule.
+  r.modification=j.at("modification");r.value=j.at("value");r.priority=j.at("priority");
+  r.actorValue=j.value("actorValue",std::string{});r.rank=j.at("rank");r.effectIndex=j.at("effectIndex");
+  r.sourceKey=j.at("origin").at("sourceKey");
+  const auto provenance=perk.ToString()+"#"+std::to_string(r.effectIndex)+" CLASS:"+r.sourceKey+" "+r.modification;
+  if(provenance.size()>=r.provenance.size())throw std::invalid_argument("rule provenance capacity");
+  std::memcpy(r.provenance.data(),provenance.c_str(),provenance.size()+1);
+  if(!std::isfinite(r.value)||!std::isfinite(r.priority)||!(Form(j.at("perk"))==perk))throw std::invalid_argument("compiled rule identity/value");
+  unsigned conditionCount=0;
+  if(j.at("conditions").size()>16)throw std::invalid_argument("tab capacity");
+  for(const auto& tab:j.at("conditions")) {
+    Tab t;
+    for(const auto& clause:tab.at("clauses")) {
+      if(clause.empty())throw std::invalid_argument("empty clause");
+      Clause cs;
+      for(const auto& row:clause) {
+        if(++conditionCount>256)throw std::invalid_argument("condition capacity");
+        Condition c;c.function=row.at("function");c.compare=row.at("compare");c.expected=row.at("comparisonValue");
+        const auto run=row.at("runOn").get<std::string>();
+        if(run!="Subject"&&run!="Target")r.supported=false;
+        c.target=run=="Target";c.actorValue=row.value("actorValue",std::string{});
+        if(row.contains("parameter"))c.key=Form(row.at("parameter"));
+        constexpr const char* functions[]={"HasKeyword","WornHasKeyword","WornApparelHasKeywordCount","HasPerk","GetIsID",
+          "GetEquippedItemType","IsWeaponSkillType","GetActorValuePercent","GetActorValue"};
+        if(std::find(std::begin(functions),std::end(functions),c.function)==std::end(functions)||!std::isfinite(c.expected))r.supported=false;
+        cs.push_back(std::move(c));
+      }
+      t.push_back(std::move(cs));
+    }
+    r.tabs.push_back(std::move(t));
+  }
+  return r;
+}
+inline Table ConvertPerks(const Json& profile) {
+  Table table;
+  if(!profile.contains("perks")){table.unsupported=1;return table;}
+  const auto& set=profile.at("perks");table.perksKnown=set.at("status")!="UNSUPPORTED";
+  const auto& rows=set.at("value");if(!rows.is_array()||rows.size()>512)throw std::invalid_argument("perk capacity");
+  unsigned index=0;
+  for(const auto& item:rows) {
+    const auto keyText=item.at("stableFormKey").get<std::string>();const auto split=keyText.rfind('|');
+    if(split==std::string::npos)throw std::invalid_argument("profile perk key");
+    const auto key=StableFormKey::Parse(keyText.substr(0,split)+":"+keyText.substr(split+1));
+    // Grant presence is known even when its semantics are unsupported.
+    if(!Contains(table.perks,key))table.perks.push_back(key);
+    if(item.at("status")!="SUPPORTED"||item.at("sourceKind")!="CLASS"||item.at("compiled").is_null()) {
+      ++table.unsupported;
+      const auto& skipped=item.at("compiled");
+      if(skipped.is_object()&&skipped.contains("rules")&&skipped.at("rules").is_array()) {
+        table.unsupportedRules+=static_cast<unsigned>(skipped.at("rules").size());
+        if(table.unsupportedRules>2048)throw std::invalid_argument("unsupported rule capacity");
+      }
+      continue;
+    }
+    const auto& compiled=item.at("compiled");
+    if(!(Form(compiled.at("perk"))==key)||compiled.at("origin").at("sourceKind")!="CLASS"
+      ||compiled.at("origin").at("sourceKey")!=item.at("sourceKey"))throw std::invalid_argument("compiled origin");
+    for(const auto& row:compiled.at("rules")) {
+      if(++index>2048)throw std::invalid_argument("rule capacity");
+      if(row.at("origin")!=compiled.at("origin"))throw std::invalid_argument("rule origin mismatch");
+      Rule rule=Convert(row,key,index);
+      if(rule.rank>=item.at("rank").get<unsigned>())rule.supported=false;
+      if(!rule.supported)++table.unsupportedRules;
+      // A record effect is active once even when two grants confer the same perk.
+      if(rule.entry==EP::Count){++table.unsupported;continue;}
+      auto& dest=table.rules[static_cast<unsigned>(rule.entry)];
+      if(std::any_of(dest.begin(),dest.end(),[&](const Rule& x){return x.perk==key&&x.effectIndex==rule.effectIndex;}))continue;
+      dest.push_back(std::move(rule));
+    }
+  }
+  for(auto& rules:table.rules) {
+    std::stable_sort(rules.begin(),rules.end(),[](const Rule& a,const Rule& b){return a.priority<b.priority;});
+    const auto active=std::count_if(rules.begin(),rules.end(),[](const Rule& r){return r.supported;});
+    const auto noncommutative=std::any_of(rules.begin(),rules.end(),[](const Rule& r){return r.supported
+      &&r.modification!="Multiply"&&r.modification!="MultiplyOnePlusAVMult"&&r.modification!="MultiplyAVMult";});
+    // Engine ordering for noncommuting operations has no certified proof yet.
+    // Do not choose an approximate order: withhold the entire affected group.
+    if(active>1&&noncommutative)for(auto& r:rules)if(r.supported)r.orderUncertified=true;
+  }
+  return table;
+}
+// Server-owned seed/state. One draw per eligible hit; reproducible from trace state.
+struct Rng {
+  uint64_t state;
+  explicit Rng(uint64_t seed):state(seed?seed:1){}
+  double Next() {state^=state<<13;state^=state>>7;state^=state<<17;return double(state>>11)*0x1.0p-53;}
+};
+}
diff --git a/unit/CombatProbeTest.h b/unit/CombatProbeTest.h
new file mode 100644
index 0000000000000000000000000000000000000000..0543207b504fa5180f885f00bb083908591c00b2
--- /dev/null
+++ b/unit/CombatProbeTest.h
@@ -0,0 +1,523 @@
+#pragma once
+// AETHERIUS DS-0b: development combat probe acceptance. Real PartOne/WorldState/
+// ActionListener with the installed load order; no listening socket.
+#include "aetherius_combat/CombatProbe.h"
+#include "ActionListener.h"
+#include "ChangeValuesMessage.h"
+#include "FormDesc.h"
+#include "HitMessage.h"
+#include "UpdateAnimationMessage.h"
+#include "MessageSerializerFactory.h"
+#include "UpdateEquipmentMessage.h"
+#include "UpdateMovementMessage.h"
+#include "PartOneListener.h"
+#include "PluginIndexMapping.h"
+#include <fstream>
+#include <iostream>
+#include <tuple>
+
+inline void RunCombatProbeTests(const std::filesystem::path& manifestPath)
+{
+  using aetherius::combat::CombatProbe;
+  std::cout << std::unitbuf;
+  int count = 0;
+  auto check = [&](bool ok, const char* why) {
+    ++count;
+    if (!ok) throw std::runtime_error(why);
+  };
+
+  // DS-0g: bounded reports and cadence copy exact attempts, no timing sleeps.
+  {
+    auto p=std::make_shared<CombatProbe>();
+    const auto base=FormDesc::FromString("23abe:Skyrim.esm");
+    for(size_t i=0;i<260;++i)p->RecordNpcReport(1,base,2,1,i%2?"ACCEPTED":"NOT_CURRENT_HOSTER",1000+i);
+    const auto json=p->Read();
+    check(json["npcReports"].size()==256 && json["counters"]["overwrittenNpcReports"]==4,"NPC report ring overflow");
+    check(json["counters"]["npcReportReasons"]["ACCEPTED"]==130,"NPC report reasons count");
+    check(json["npcReports"][0]["base"]==base.ToString(),"NPC report stable base");
+    const auto start=std::chrono::steady_clock::time_point(std::chrono::seconds(100));
+    p->RecordAttackAttempt(1,0.7f,true,0,false,start);
+    auto first=CombatProbe::CadenceJson(p->LatestCadence(1));
+    check(first["sincePreviousAttemptMs"].is_null() && first["sincePreviousAcceptedMs"].is_null(),"first attack invented an interval");
+    p->RecordAttackAttempt(1,0.7f,true,500,true,start+std::chrono::milliseconds(250));
+    const auto next=CombatProbe::CadenceJson(p->LatestCadence(1));
+    check(std::abs(next["sincePreviousAttemptMs"].get<float>()-250)<0.01,"previous attempt cadence");
+    check(std::abs(next["limitMs"].get<float>()-864.2857f)<0.01,"slow weapon CanHit measurement");
+    p->RecordAttackAttempt(2,1.f,true,1000,true,start);
+    check(CombatProbe::CadenceJson(p->LatestCadence(2))["sincePreviousAttemptMs"].is_null(),"cadence mixed aggressors");
+    check(std::abs(CombatProbe::CadenceJson(p->LatestCadence(2))["limitMs"].get<float>()-770.f)<0.01,"fast weapon CanHit measurement");
+    p->RecordAttackAttempt(2,0,false,1000,true,start);
+    check(CombatProbe::CadenceJson(p->LatestCadence(2))["weaponSpeed"].is_null(),"unavailable weapon speed invented");
+  }
+
+  // ---- 1. Pure buffers: overflow, order, non-destructive read ----------------
+  {
+    auto probe = std::make_shared<CombatProbe>(1000);
+    CombatProbe::HitInput input;
+    input.aggressor = 1; input.target = 2; input.source = 0x1f4;
+    const size_t extra = 5;
+    for (size_t i = 0; i < CombatProbe::kHitCapacity + extra; ++i) {
+      input.damage = static_cast<float>(i);
+      probe->RecordHit(input, 2000 + i);
+    }
+    const auto& hits = probe->Hits();
+    check(hits.size == CombatProbe::kHitCapacity, "hit ring grew beyond capacity");
+    check(hits.total == CombatProbe::kHitCapacity + extra, "hit total counter");
+    check(hits.Overwritten() == extra, "hit overwrite counter");
+    check(hits.At(0).sequence == extra + 1, "oldest retained hit sequence");
+    check(hits.At(hits.size - 1).sequence == hits.total, "newest hit sequence");
+    bool ascending = true;
+    for (size_t i = 1; i < hits.size; ++i)
+      ascending = ascending && hits.At(i).sequence == hits.At(i - 1).sequence + 1;
+    check(ascending, "hit ring order");
+    const auto first = probe->Read();
+    const auto second = probe->Read();
+    check(first == second, "read is not idempotent / emptied buffers");
+    check(first["counters"]["overwrittenHits"] == extra, "json overwrite counter");
+    check(first["hits"].size() == CombatProbe::kHitCapacity, "json hit rows");
+    check(first["hits"][0]["sequence"] == extra + 1 &&
+            first["hits"].back()["sequence"] == hits.total,
+          "json hit order");
+    check(first["hits"][0]["damage"] == static_cast<float>(extra), "json oldest hit payload");
+    check(first["startedAtMs"] == 1000, "startedAtMs");
+
+    for (size_t i = 0; i < CombatProbe::kHealthCapacity + 3; ++i)
+      probe->RecordHealth(7, 1.f, 0.5f, 0.5f, 3000 + i);
+    check(probe->Health().size == CombatProbe::kHealthCapacity &&
+            probe->Health().Overwritten() == 3 &&
+            probe->Health().At(0).sequence == 4,
+          "health ring overflow/order");
+
+    // Animations: ring, name table limited to 256, overflow counted.
+    for (size_t i = 0; i < CombatProbe::kNameCapacity + 44; ++i)
+      probe->RecordAnimation(9, "anim" + std::to_string(i), 4000 + i);
+    for (int i = 0; i < 3; ++i) probe->RecordAnimation(9, "anim0", 5000 + i);
+    check(probe->DistinctNames() == CombatProbe::kNameCapacity, "name table not limited");
+    check(probe->NameOverflow() == 44, "name overflow count");
+    const auto names = probe->Read()["animationNames"];
+    check(names.size() == CombatProbe::kNameCapacity && names[0]["name"] == "anim0" &&
+            names[0]["count"] == 4,
+          "distinct-name counter");
+    for (size_t i = 0; i < CombatProbe::kAnimationCapacity; ++i)
+      probe->RecordAnimation(10, "attackStart", 6000);
+    check(probe->Animations().size == CombatProbe::kAnimationCapacity &&
+            probe->Animations().Overwritten() ==
+              CombatProbe::kNameCapacity + 44 + 3,
+          "animation ring overflow");
+    const std::string longName(100, 'x');
+    probe->RecordAnimation(10, longName, 6001);
+    const auto truncated = probe->Read();
+    check(truncated["counters"]["truncatedNames"] == 1 &&
+            truncated["animations"].back()["name"].get<std::string>().size() ==
+              CombatProbe::kNameBytes - 1,
+          "long name truncation");
+    probe->RecordAnimation(10, std::string("bad\xff\xfe", 5), 6002);
+    bool dumped = true;
+    try { (void)probe->ReadString(); } catch (...) { dumped = false; }
+    check(dumped, "invalid UTF-8 animation name broke the read");
+
+    // Last two animation events of the aggressor, with age at hit time.
+    auto fresh = std::make_shared<CombatProbe>();
+    fresh->RecordAnimation(11, "attackStart", 10000);
+    fresh->RecordAnimation(12, "blockStart", 10050);
+    fresh->RecordAnimation(11, "attackPowerStartInPlace", 10100);
+    CombatProbe::HitInput power;
+    power.aggressor = 11; power.target = 12; power.power = true;
+    fresh->RecordHit(power, 10350);
+    power.aggressor = 99;
+    fresh->RecordHit(power, 10351);
+    const auto recent = fresh->Read()["hits"];
+    check(recent[0]["aggressorAnimations"].size() == 2 &&
+            recent[0]["aggressorAnimations"][0]["name"] == "attackPowerStartInPlace" &&
+            recent[0]["aggressorAnimations"][0]["ageMs"] == 250 &&
+            recent[0]["aggressorAnimations"][1]["name"] == "attackStart" &&
+            recent[0]["aggressorAnimations"][1]["ageMs"] == 350,
+          "aggressor recent animations");
+    check(recent[1]["aggressorAnimations"].empty(), "unknown aggressor must have no animations");
+
+    // Actor table is fixed: more actors than slots evict, never grow.
+    auto actors = std::make_shared<CombatProbe>();
+    for (uint32_t a = 1; a <= CombatProbe::kActorSlots + 2; ++a)
+      actors->RecordAnimation(a, "attackStart", a);
+    check(actors->ActorEvictions() == 2, "actor table eviction count");
+
+    // Equipment transitions: fixed ring, order, per-transition entry limit.
+    auto equipment = std::make_shared<CombatProbe>();
+    Equipment big;
+    for (uint32_t i = 0; i < CombatProbe::kEquipmentItems + 1; ++i) {
+      Inventory::Entry e(0x100 + i, 1);
+      e.SetWorn(Inventory::Worn::Right);
+      big.inv.entries.push_back(e);
+    }
+    big.inv.entries[0].enchantmentId = 0x77;
+    for (size_t i = 0; i < CombatProbe::kEquipmentCapacity + 3; ++i) {
+      big.numChanges = static_cast<uint32_t>(i);
+      equipment->RecordEquipment(5, big, 7000 + i);
+    }
+    const auto& changes = equipment->EquipmentChanges();
+    check(changes.size == CombatProbe::kEquipmentCapacity && changes.Overwritten() == 3 &&
+            changes.At(0).sequence == 4 && changes.At(changes.size - 1).sequence == changes.total,
+          "equipment ring overflow/order");
+    const auto eqJson = equipment->Read();
+    check(eqJson["counters"]["truncatedEquipmentEntries"] == CombatProbe::kEquipmentCapacity + 3 &&
+            eqJson["equipment"][0]["items"].size() == CombatProbe::kEquipmentItems &&
+            eqJson["equipment"][0]["totalEntries"] == CombatProbe::kEquipmentItems + 1 &&
+            eqJson["equipment"][0]["items"][0]["enchantmentId"] == 0x77 &&
+            eqJson["equipment"][0]["items"][1]["enchantmentId"].is_null() &&
+            eqJson["counters"]["overwrittenEquipment"] == 3,
+          "equipment entries truncation counted / json");
+    CombatProbe::ActorState state; state.present = true; state.actor = 1;
+    state.position = { 0, 0, 0 }; state.cellOrWorld.Assign(FormDesc::FromString("3c:Skyrim.esm"));
+    auto distantState = state; distantState.actor = 2; distantState.position = { 5000, 0, 0 };
+    for (size_t i = 0; i < CombatProbe::kRejectionCapacity + 3; ++i)
+      equipment->RecordRejection("TOO_DISTANT", 1, 2, 3, 0, state, distantState, 8000 + i);
+    const auto refused = equipment->Read();
+    check(refused["rejections"].size() == CombatProbe::kRejectionCapacity &&
+      refused["counters"]["overwrittenRejections"] == 3 && refused["rejections"][0]["sequence"] == 4,
+      "rejection ring overflow/order");
+    check(refused["rejections"][0]["distance"] == 5000 &&
+      refused["rejections"][0]["targetState"]["cellOrWorld"] == "3c:Skyrim.esm",
+      "rejection distance / portable cell");
+    std::cout << "Fixed probe bytes=" << sizeof(CombatProbe)
+              << " hits=" << CombatProbe::kHitCapacity
+              << " animations=" << CombatProbe::kAnimationCapacity
+              << " health=" << CombatProbe::kHealthCapacity
+              << " names=" << CombatProbe::kNameCapacity << '\n';
+  }
+
+  // ---- 1b. ResolveEnchantment with the ENCH/MGEF plugin in two positions -----
+  // Same StableFormKeys, two valid arrangements of the vanilla masters (the DLC
+  // masters depend only on Skyrim.esm/Update.esm). Dragonborn.esm moves from
+  // index 4 to index 2, so both the ENCH and its MGEF get other runtime IDs.
+  {
+    const auto dataDir = manifestPath.parent_path();
+    const std::vector<std::vector<std::string>> arrangements = {
+      { "Skyrim.esm", "Update.esm", "Dawnguard.esm", "HearthFires.esm", "Dragonborn.esm" },
+      { "Skyrim.esm", "Update.esm", "Dragonborn.esm", "Dawnguard.esm", "HearthFires.esm" }
+    };
+    std::vector<nlohmann::json> stable;
+    std::vector<uint32_t> runtimeEnch, runtimeMgef;
+    for (const auto& names : arrangements) {
+      std::vector<std::filesystem::path> files;
+      for (const auto& name : names) files.push_back(dataDir / name);
+      espm::Loader arranged(files);
+      PluginIndexMapping mapping;
+      mapping.Build(arranged.GetFileNames(), &arranged);
+      const uint32_t spell = FormDesc::FromString("1e2a6:Dragonborn.esm").ToFormId(mapping);
+      check(CombatProbe::ResolveRecordType(arranged.GetBrowser(), spell)["type"] == "SPEL",
+            "reordered spell type unresolved");
+      const uint32_t ench = FormDesc::FromString("1e288:Dragonborn.esm").ToFormId(mapping);
+      check(CombatProbe::ResolveRecordType(arranged.GetBrowser(), ench)["type"] == "ENCH",
+            "record type changes with plugin position");
+      const auto result = CombatProbe::ResolveEnchantment(arranged.GetBrowser(),
+                                                          arranged.GetBrowser().GetCache(), ench);
+      check(result["status"] == "SUPPORTED" && result["effects"].size() == 1,
+            "reordered ENCH 01E288:Dragonborn.esm not resolved");
+      const auto& effect = result["effects"][0];
+      const auto mgefKey = FormDesc::FromFormId(effect["mgef"].get<uint32_t>(), mapping).ToString();
+      check(effect["mgef"].get<uint32_t>() ==
+              FormDesc::FromString("1e289:Dragonborn.esm").ToFormId(mapping),
+            "MGEF runtime id does not match its StableFormKey in this arrangement");
+      stable.push_back({ { "mgef", mgefKey }, { "magnitude", effect["magnitude"] },
+                         { "actorValue", effect["actorValue"] }, { "archetype", effect["archetype"] } });
+      runtimeEnch.push_back(ench);
+      runtimeMgef.push_back(effect["mgef"].get<uint32_t>());
+      std::cout << "ARRANGEMENT [" << names[2] << ',' << names[3] << ',' << names[4]
+                << "] ench=0x" << std::hex << ench << std::dec << " -> " << result.dump()
+                << " stable=" << stable.back().dump() << '\n';
+    }
+    check(runtimeEnch[0] != runtimeEnch[1], "arrangements did not move the ENCH plugin");
+    check(runtimeMgef[0] != runtimeMgef[1], "arrangements did not move the MGEF plugin");
+    check(stable[0] == stable[1], "reordered resolution changed MGEF identity/magnitude/actor value");
+    check(stable[0]["magnitude"] == 5.0, "winner magnitude of 01E288:Dragonborn.esm");
+  }
+
+  // ---- 2. Real host path: off has no effect, on records, game unchanged ------
+  std::ifstream in(manifestPath);
+  nlohmann::json manifest;
+  in >> manifest;
+  std::vector<std::filesystem::path> paths;
+  for (const auto& row : manifest.at("plugins"))
+    paths.push_back(manifestPath.parent_path() / row.at("filename").get<std::string>());
+  espm::Loader loader(paths);
+  PartOne host;
+  host.AttachEspm(&loader);
+  auto resolve = [&](const char* key) {
+    return FormDesc::FromString(key).ToFormId(host.worldState.pluginIndexMapping);
+  };
+  struct KnownDamage final : IDamageFormula
+  {
+    float CalculateDamage(const MpActor&, const MpActor&, const HitData&) const override { return 30.f; }
+    float CalculateDamage(const MpActor&, const MpActor&, const SpellCastData&) const override { return 30.f; }
+  };
+  host.SetDamageFormula(std::make_unique<KnownDamage>());
+  const auto cell = resolve("3c:Skyrim.esm");
+  const auto attackerId = host.CreateActor(0, { 0, 0, 0 }, 0, cell);
+  const auto targetId = host.CreateActor(0, { 0, 0, 0 }, 0, cell);
+  auto& attacker = host.worldState.GetFormAt<MpActor>(attackerId);
+  auto& target = host.worldState.GetFormAt<MpActor>(targetId);
+  host.serverState.Connect(0, "DS-0b-attacker");
+  host.SetUserActor(0, attackerId);
+  host.serverState.Connect(1, "DS-0b-target");
+  host.SetUserActor(1, targetId);
+  const auto unarmed = resolve("1f4:Skyrim.esm");
+  // NPC hosted by the attacker's client (same construction as DevAttributesTest).
+  const auto npcId = host.worldState.GenerateFormId();
+  host.worldState.AddForm(std::make_unique<MpActor>(
+    LocationalData{ { 0, 0, 0 }, { 0, 0, 0 },
+                    FormDesc::FromFormId(cell, host.worldState.pluginIndexMapping) },
+    host.CreateFormCallbacks(), resolve("422b4:Skyrim.esm")), npcId);
+  auto& npc = host.worldState.GetFormAt<MpActor>(npcId);
+  host.worldState.hosters[npcId] = attackerId;
+
+  // Read-only enchantment resolution against the installed winners.
+  {
+    using R = CombatProbe;
+    auto& browser = loader.GetBrowser();
+    auto& cache = host.worldState.GetEspmCache();
+    const auto fire = R::ResolveEnchantment(browser, cache, resolve("45c35:Skyrim.esm"));
+    check(fire["status"] == "SUPPORTED" && !fire["effects"].empty() &&
+            fire["effects"][0]["mgef"] == resolve("4605a:Skyrim.esm"),
+          "static ENCH 045C35:Skyrim.esm not resolved with its MGEF");
+    check(R::ResolveEnchantment(browser, cache, resolve("1397e:Skyrim.esm"))["reason"] == "NOT_AN_ENCH_RECORD",
+          "non-ENCH accepted as enchantment");
+    check(R::ResolveEnchantment(browser, cache, 0xFF000123)["reason"] == "CREATED_RECORD_NOT_IN_LOAD_ORDER",
+          "created enchantment not declared unsupported");
+    check(R::ResolveEnchantment(browser, cache, 0)["status"] == "UNSUPPORTED", "zero id");
+    std::cout << "ENCH 045C35:Skyrim.esm -> " << fire.dump() << '\n';
+  }
+
+  // One scripted exchange: animation, accepted hit, client health report.
+  auto scenario = [&]() {
+    auto full = target.GetActorValues();
+    full.healthPercentage = 1.f; full.magickaPercentage = 1.f; full.staminaPercentage = 1.f;
+    if (target.IsDead()) target.SetIsDead(false);
+    target.SetPercentages(full);
+    attacker.SetLastHitTime(targetId, std::chrono::steady_clock::now() - std::chrono::seconds(10));
+    RawMessageData attackerRaw; attackerRaw.userId = 0;
+    // The host forwards the raw packet; serialize it as the network would.
+    auto sendAnimation = [&](uint32_t idx, const char* name) {
+      UpdateAnimationMessage anim; anim.idx = idx; anim.data.animEventName = name;
+      SLNet::BitStream packet; PartOne::GetMessageSerializerInstance().Serialize(anim, packet);
+      RawMessageData raw = attackerRaw;
+      raw.unparsed = packet.GetData(); raw.unparsedLength = packet.GetNumberOfBytesUsed();
+      host.GetActionListener().OnUpdateAnimation(raw, anim);
+    };
+    // Hosted NPC animation first, then the player's own attack animation.
+    // AnimationSystem is not initialized here (no SweetPie callbacks): the probe
+    // must record names independently of any callback.
+    sendAnimation(npc.GetIdx(), "attackStart");
+    sendAnimation(attacker.GetIdx(), "attackPowerStartInPlace");
+    HitMessage hit; hit.data.aggressor = 0x14; hit.data.target = targetId;
+    hit.data.source = unarmed; hit.data.isPowerAttack = true;
+    host.GetActionListener().OnHit(attackerRaw, hit);
+    const float afterHit = target.GetActorValues().healthPercentage;
+    RawMessageData targetRaw; targetRaw.userId = 1;
+    ChangeValuesMessage values; values.data.health = afterHit - 0.2f;
+    host.GetActionListener().OnChangeValues(targetRaw, values);
+    const float afterReport = target.GetActorValues().healthPercentage;
+    return std::make_tuple(afterHit, afterReport, attacker.IsBlockActive(),
+                           target.IsBlockActive(), attacker.GetLastAnimEvent().has_value());
+  };
+
+  aetherius::combat::InstallCombatProbe(nullptr);
+  check(aetherius::combat::ActiveCombatProbe() == nullptr, "probe active without installation");
+  const auto off = scenario();
+  check(std::get<0>(off) < 1.f, "baseline hit did not apply damage");
+  check(std::get<1>(off) < std::get<0>(off), "baseline client drop not accepted");
+
+  auto probe = std::make_shared<CombatProbe>(aetherius::combat::CombatProbeNowMs());
+  aetherius::combat::InstallCombatProbe(probe);
+  const auto on = scenario();
+  check(on == off, "probe ON changed game state");
+  const auto snapshot = probe->Read();
+  check(snapshot["hits"].size() == 1, "accepted hit not recorded");
+  const auto& h = snapshot["hits"][0];
+  check(h["aggressor"] == attackerId && h["target"] == targetId && h["source"] == unarmed,
+        "hit identity");
+  check(h["family"] == "UNARMED" && h["power"] == true && h["clientBlocked"] == false,

+  // Read-only accessors for tests and diagnostics.
+  const Ring<HitSample, kHitCapacity>& Hits() const noexcept { return hits; }
+  const Ring<AnimationSample, kAnimationCapacity>& Animations() const noexcept
+  {
+    return animations;
+  }

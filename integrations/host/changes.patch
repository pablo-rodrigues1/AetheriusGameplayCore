+  uint64_t NameOverflow() const noexcept { return nameOverflow; }
+  uint64_t ActorEvictions() const noexcept { return actorEvictions; }
+
+private:
+  template<size_t N> struct Text
+  {
+    std::array<char, N> bytes{};
+    size_t size = 0;
+    bool complete = false;
+    void Assign(std::string_view value) noexcept
+    {
+      complete = value.size() <= N; size = std::min(value.size(), N);
+      std::memcpy(bytes.data(), value.data(), size);
+    }
+    bool Matches(std::string_view value) const noexcept
+    { return complete && size == value.size() && std::memcmp(bytes.data(), value.data(), size) == 0; }
+  };
+  // Created once with the probe; avoids the implicit temporary std::string in
+  // GetValueDump("skyDeathAidWeakness") on the recording path.
+  const std::string weaknessKey = "skyDeathAidWeakness";
+  struct StateEntry
+  {
+    uint32_t actor = 0;
+    const MpObjectReference* identity = nullptr; // identity only; never dereferenced
+    ActorState movement{}, maximumState{};
+    NpcCorrection lastNpcCorrection;
+    Text<4096> appearance;
+    Text<1024> weakness;
+    uint64_t maximumRevision = 0;
+    Networking::UserId user = Networking::InvalidUserId;
+    int32_t profile = 0;
+    double weaknessUntil = 0;
+    float unweakenedHealth = 0;
+    float maximumHealth = 0;
+    uint64_t maximumObservedMs = 0;
+    uint64_t lastMovementAttemptMs = 0, rejectedMovements = 0;
+    bool lastMovementAccepted = false;
+    std::array<float, 3> lastAttemptPosition{};
+    uint32_t lastAttemptCellOrWorld = 0;
+  };
+  StateEntry& StateSlot(uint32_t actor, const MpObjectReference* identity) noexcept
+  {
+    auto& entry = states[Hash(actor)];
+    if (entry.actor != actor || entry.identity != identity) {
+      if (entry.identity) ++stateEvictions;
+      entry = {}; entry.actor = actor; entry.identity = identity;
+    }
+    return entry;
+  }
+  static ActorState CaptureCoordinates(const MpObjectReference& ref, WorldState& world) noexcept
+  {
+    ActorState s;
+    s.present = true; s.actor = ref.GetFormId(); s.base = ref.GetBaseId();
+    const auto& p = ref.GetPos(); s.position = { p[0], p[1], p[2] };
+    s.cellOrWorld.Assign(ref.GetCellOrWorld());
+    const auto it = world.hosters.find(s.actor);
+    if (it != world.hosters.end()) s.hoster = it->second;
+    return s;
+  }
+  std::array<StateEntry, kActorSlots> states{};
+  uint64_t stateEvictions = 0;
+  uint64_t npcMovementDistance = 0, npcMovementWorldOrCell = 0, npcMovementTeleportFlag = 0;
+  uint64_t npcCorrectionsSent = 0, npcCorrectionsSuppressed = 0;
+  struct ActorEntry
+  {
+    uint32_t actor = 0;
+    bool used = false;
+    std::array<RecentAnimation, 2> recent{};
+    Cadence cadence;
+    bool hasAttempt = false;
+    std::chrono::steady_clock::time_point lastAttempt{};
+  };
+
+  static size_t Hash(uint32_t actor) noexcept
+  {
+    return static_cast<size_t>((static_cast<uint64_t>(actor) * 2654435761ull) %
+                               kActorSlots);
+  }
+
+  const ActorEntry* FindActor(uint32_t actor) const noexcept
+  {
+    const size_t start = Hash(actor);
+    for (size_t i = 0; i < kActorSlots; ++i) {
+      const auto& entry = actors[(start + i) % kActorSlots];
+      if (!entry.used) {
+        return nullptr;
+      }
+      if (entry.actor == actor) {
+        return &entry;
+      }
+    }
+    return nullptr;
+  }
+
+  ActorEntry& ActorSlot(uint32_t actor) noexcept
+  {
+    const size_t start = Hash(actor);
+    for (size_t i = 0; i < kActorSlots; ++i) {
+      auto& entry = actors[(start + i) % kActorSlots];
+      if (!entry.used) {
+        entry.used = true;
+        entry.actor = actor;
+        entry.recent = {};
+        return entry;
+      }
+      if (entry.actor == actor) {
+        return entry;
+      }
+    }
+    // Full table: replace the home slot. Probing stays correct because no
+    // slot ever becomes unused again.
+    ++actorEvictions;
+    auto& entry = actors[start];
+    entry = {}; entry.used = true; entry.actor = actor;
+    return entry;
+  }
+
+  void CountName(const Name& name) noexcept
+  {
+    const auto view = name.View();
+    for (size_t i = 0; i < namesUsed; ++i) {
+      if (names[i].name.View() == view) {
+        ++names[i].count;
+        return;
+      }
+    }
+    if (namesUsed < kNameCapacity) {
+      names[namesUsed].name = name;
+      names[namesUsed].count = 1;
+      ++namesUsed;
+      return;
+    }
+    ++nameOverflow;
+  }
+
+  uint64_t startedAtMs = 0;
+  Ring<HitSample, kHitCapacity> hits;
+  Ring<RejectionSample, kRejectionCapacity> rejections;
+  Ring<NpcEquipment, 64> npcEquipment;
+  Ring<NpcUnavailable, 256> npcUnavailable;
+  std::array<NameCount, 32> npcUnavailableReasons{}, npcUnavailableResults{};
+  size_t npcUnavailableReasonCount = 0, npcUnavailableResultCount = 0;
+  uint64_t npcUnavailableReasonOverflow = 0, npcUnavailableResultOverflow = 0;
+  Ring<NpcReport, 256> npcReports;
+  std::array<std::array<NameCount, 32>, 2> npcVersionReasons{};
+  std::array<size_t, 2> npcVersionReasonCounts{};
+  std::array<uint64_t, 2> npcVersionTotals{}, npcVersionReasonOverflows{};
+  std::array<NameCount, 32> npcReasons{};
+  size_t npcReasonCount = 0;
+  uint64_t npcReasonOverflow = 0;
+  std::array<NameCount, 32> npcRestoreReasons{};
+  size_t npcRestoreReasonCount = 0;
+  uint64_t npcRestoreFailures = 0, npcRestoreReasonOverflow = 0;
+  Ring<AnimationSample, kAnimationCapacity> animations;
+  Ring<HealthSample, kHealthCapacity> health;
+  Ring<EquipmentSample, kEquipmentCapacity> equipmentChanges;
+  uint64_t truncatedEquipmentEntries = 0;
+  std::array<NameCount, kNameCapacity> names{};
+  size_t namesUsed = 0;
+  uint64_t nameOverflow = 0, truncatedNames = 0, actorEvictions = 0;
+  std::array<ActorEntry, kActorSlots> actors{};
+};
+
+// Process-wide installation point. ScampServer installs the probe only when
+// aetheriusCombat.probe is true; otherwise it stays null and every hook in
+// ActionListener is a single null check.
+inline std::shared_ptr<CombatProbe>& InstalledCombatProbe() noexcept
+{
+  static std::shared_ptr<CombatProbe> probe;
+  return probe;
+}
+
+inline void InstallCombatProbe(std::shared_ptr<CombatProbe> probe) noexcept
+{
+  InstalledCombatProbe() = std::move(probe);
+}
+
+inline CombatProbe* ActiveCombatProbe() noexcept
+{
+  return InstalledCombatProbe().get();
+}
+
+inline uint64_t CombatProbeNowMs() noexcept
+{
+  return static_cast<uint64_t>(
+    std::chrono::duration_cast<std::chrono::milliseconds>(
+      std::chrono::system_clock::now().time_since_epoch())
+      .count());
+}
+
+} // namespace aetherius::combat
diff --git a/server/cpp/server_guest_lib/aetherius_combat/NpcObservation.h b/server/cpp/server_guest_lib/aetherius_combat/NpcObservation.h
new file mode 100644
index 0000000000000000000000000000000000000000..90ff5dd2c4f9d6457091999e686efecbb95bcc2a
--- /dev/null
+++ b/server/cpp/server_guest_lib/aetherius_combat/NpcObservation.h
@@ -0,0 +1,156 @@
+#pragma once
+// DS-0g: read-only winning NPC/CLAS fields missing from libespm's public Data.
+// Binary schema: TES5Edit/Core/wbDefinitionsTES5.pas (ACBS, CNAM, DNAM,
+// CLAS.DATA, RACE.DATA). No runtime plugin index is part of this schema.
+#include "WorldState.h"
+#include "FormDesc.h"
+#include "libespm/RecordHeaderAccess.h"
+#include "libespm/CombineBrowser.h"
+#include "libespm/espm.h"
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstring>
+#include <numeric>
+#include <optional>
+#include <stdexcept>
+
+namespace aetherius::npc {
+// Wire vocabulary, shared by validation and diagnostics; no exception text.
+inline bool IsUnavailableReason(std::string_view reason) {
+  return reason == "ACTOR_NOT_LOADED" || reason == "RESOLVED_BASE_ABSENT" ||
+    reason == "RESOLVED_BASE_HAS_NO_STABLE_KEY" || reason == "INVALID_ENGINE_LEVEL" ||
+    reason == "ENGINE_READ_FAILED" || reason == "RACE_ABSENT" || reason == "RACE_HAS_NO_STABLE_KEY";
+}
+struct Fields {
+  bool present = false, autoCalc = false, pcMult = false, skillsPresent = false;
+  uint16_t level = 0, min = 0, max = 0;
+  uint32_t classId = 0;
+  std::array<float, 18> skills{};
+};
+template<class T> inline T Read(const char* p) {
+  T result; std::memcpy(&result, p, sizeof(result)); return result;
+}
+inline Fields ReadNpc(const espm::LookupResult& lookup, espm::CompressedFieldsCache& cache) {
+  Fields result;
+  if (!lookup.rec || lookup.rec->GetType() != espm::NPC_::kType) return result;
+  espm::RecordHeaderAccess::IterateFields(lookup.rec, [&](const char* type, uint32_t size, const char* p) {
+    if (!std::memcmp(type, "ACBS", 4) && size >= 24) {
+      result.present = true;
+      const auto flags = Read<uint32_t>(p);
+      result.autoCalc = (flags & 0x10) != 0; result.pcMult = (flags & 0x80) != 0;
+      result.level = Read<uint16_t>(p + 8);
+      result.min = Read<uint16_t>(p + 10); result.max = Read<uint16_t>(p + 12);
+    } else if (!std::memcmp(type, "CNAM", 4) && size == 4) {
+      result.classId = lookup.ToGlobalId(Read<uint32_t>(p));
+    } else if (!std::memcmp(type, "DNAM", 4) && size >= 36) {
+      result.skillsPresent = true;
+      for (size_t i = 0; i < 18; ++i)
+        result.skills[i] = Read<uint8_t>(p + i) + Read<uint8_t>(p + 18 + i);
+    }
+  }, cache);
+  return result;
+}
+inline bool LevelCompatible(const Fields& f, uint32_t level) {
+  return f.present && level > 0 && level <= 65535 &&
+    (f.pcMult ? ((!f.min || level >= f.min) && (!f.max || level <= f.max)) : level == f.level);
+}
+struct ClassFields {
+  bool present = false;
+  std::array<unsigned, 18> skills{};
+  std::array<unsigned, 3> stats{};
+};
+inline ClassFields ReadClass(const espm::LookupResult& lookup, espm::CompressedFieldsCache& cache) {
+  ClassFields result;
+  if (!lookup.rec || lookup.rec->GetType() != "CLAS") return result;
+  espm::RecordHeaderAccess::IterateFields(lookup.rec, [&](const char* type, uint32_t size, const char* p) {
+    if (!std::memcmp(type, "DATA", 4) && size >= 36) {
+      result.present = true;
+      for (size_t i = 0; i < 18; ++i) result.skills[i] = Read<uint8_t>(p + 6 + i);
+      for (size_t i = 0; i < 3; ++i) result.stats[i] = Read<uint8_t>(p + 32 + i);
+    }
+  }, cache);
+  return result;
+}
+// Integer weighted allocation. Bulk shares, equal redistribution of capped
+// excess, then one point per pass in descending weight / descending AV order.
+// Source for skills: dado3212's original assembly reconstruction (auto_calc.c,
+// 2026-09-26). Unsupported byte-overflow inputs are explicit, never wrapped.
+template<size_t N> inline void Distribute(std::array<float, N>& values,
+    std::array<unsigned, N> weights, unsigned points, float cap) {
+  const unsigned total = std::accumulate(weights.begin(), weights.end(), 0u);
+  if (!points || !total) return;
+  std::array<size_t, N> order{}; std::iota(order.begin(), order.end(), 0);
+  std::sort(order.begin(), order.end(), [&](size_t a, size_t b) {
+    return weights[a] != weights[b] ? weights[a] > weights[b] : a > b;
+  });
+  unsigned remaining = points % total, excess = 0, capped = 0;
+  auto award = [&](size_t i, unsigned amount) {
+    if (N == 18 && amount > 255) throw std::runtime_error("UNSUPPORTED: NPC_SKILL_BYTE_OVERFLOW");
+    const float next = values[i] + amount;
+    values[i] = std::min(next, cap);
+    return next > cap ? static_cast<unsigned>(next - cap) : 0u;
+  };
+  for (auto i : order) {
+    const auto over = award(i, weights[i] * (points / total));
+    excess += over; if (over) ++capped;
+  }
+  while (excess && capped < N) {
+    const unsigned amount = excess / (N - capped);
+    if (!amount) break;
+    bool progress = false;
+    for (auto i : order) if (weights[i] && values[i] < cap) {
+      const auto over = award(i, amount); excess = excess - amount + over;
+      if (over) ++capped; progress = true;
+    }
+    if (!progress) break;
+  }
+  remaining += excess;
+  while (remaining) {
+    bool attempted = false;
+    for (auto i : order) if (weights[i] && remaining) {
+      remaining = remaining - 1 + award(i, 1); --weights[i]; attempted = true;
+    }
+    if (!attempted) break;
+  }
+}
+// Typed GMST read: libespm::GMST::Data currently interprets DATA as float even
+// for integer settings, so read DATA by its confirmed EDID type here.
+template<class T> inline T Setting(WorldState& world, const char* key, const char* editorId) {
+  const auto desc=FormDesc::FromString(key);
+  if(world.pluginIndexMapping.GetEspmFileIndexByFilename(desc.file)==PluginIndexMapping::kInvalidFileIndex)
+    throw std::runtime_error(std::string("UNSUPPORTED: NPC_GMST_PLUGIN_ABSENT_")+editorId);
+  const auto id=desc.ToFormId(world.pluginIndexMapping);
+  const auto lookup=world.GetEspm().GetBrowser().LookupById(id);
+  if(!lookup.rec || lookup.rec->GetType()!=espm::GMST::kType)
+    throw std::runtime_error(std::string("UNSUPPORTED: NPC_GMST_ABSENT_")+editorId);
+  bool name=false, present=false; T value{};
+  espm::RecordHeaderAccess::IterateFields(lookup.rec,[&](const char* type,uint32_t size,const char* p) {
+    if(!std::memcmp(type,"EDID",4)) name=size==std::strlen(editorId)+1 && !std::memcmp(p,editorId,size-1);
+    if(!std::memcmp(type,"DATA",4) && size==sizeof(T)) { value=Read<T>(p);present=true; }
+  },world.GetEspmCache());
+  if(!name || !present || !std::isfinite(static_cast<double>(value)) || value<0)
+    throw std::runtime_error(std::string("UNSUPPORTED: NPC_GMST_INVALID_")+editorId);
+  return value;
+}
+inline std::array<float, 18> AutoSkills(const espm::RecordHeader* race,
+    espm::CompressedFieldsCache& cache, const ClassFields& cls, uint32_t level, unsigned start, unsigned pointsPerLevel) {
+  std::array<float, 18> result; result.fill(static_cast<float>(start));
+  bool present = false;
+  espm::RecordHeaderAccess::IterateFields(race, [&](const char* type, uint32_t size, const char* p) {
+    if (!std::memcmp(type, "DATA", 4) && size >= 14) {
+      present = true;
+      for (size_t j = 0; j < 7; ++j) {
+        const auto skill = Read<uint8_t>(p + 2*j);
+        if (skill == 255) continue;
+        // RACE stores ActorValue 6..23, not the CLAS/DNAM skill index 0..17.
+        if (skill < 6 || skill >= 24) throw std::runtime_error("UNSUPPORTED: RACE_SKILL_ACTOR_VALUE");
+        result[skill - 6] += Read<int8_t>(p + 2*j + 1);
+      }
+    }
+  }, cache);
+  if (!present) throw std::runtime_error("UNSUPPORTED: RACE_SKILL_BOOSTS_ABSENT");
+  Distribute(result, cls.skills, pointsPerLevel * (level - 1), 100.f);
+  return result;
+}
+}
diff --git a/server/cpp/server_guest_lib/aetherius_combat/ds5a/AttackEvidence.h b/server/cpp/server_guest_lib/aetherius_combat/ds5a/AttackEvidence.h
new file mode 100644
index 0000000000000000000000000000000000000000..2e92a7521d4bf48c64b3b5f83a1770e6f01d7e5e
--- /dev/null
+++ b/server/cpp/server_guest_lib/aetherius_combat/ds5a/AttackEvidence.h
@@ -0,0 +1,31 @@
+#pragma once
+#include <chrono>
+#include <string_view>
+#include <cstdint>
+namespace aetherius::combat::ds5b {
+// Fixed storage on each actor. Only the accepted animation ingress writes it.
+// A confirmation is evidence of an animation, not a unique hit (DS-7 pending).
+struct AttackEvidence {
+  enum class Kind { None, Power, Bash };
+  Kind kind=Kind::None;
+  uint64_t generation=0;
+  uint32_t hoster=0;
+  std::chrono::steady_clock::time_point received{};
+  void Record(std::string_view event,uint32_t owner,uint64_t epoch,std::chrono::steady_clock::time_point now) {
+    // Exact event names from AnimationSystem.cpp; unknown/directional stays conventional (Q7).
+    constexpr std::string_view power[]={"attackPowerStartInPlace","attackPowerStartBackward","attackPowerStartLeft",
+      "attackPowerStartRight","attackPowerStartDualWield","attackPowerStartForward","attackPowerStart_2HWSprint","attackPowerStart_2HMSprint"};
+    Kind next=Kind::None;
+    for(auto name:power)if(event==name)next=Kind::Power;
+    if(event=="bashStart"||event=="bashRelease"||event=="bashPowerStart")next=Kind::Bash;
+    // Hit-frame events do not clear a preceding start confirmation.
+    if(event=="weaponSwing"||event=="weaponLeftSwing"||event=="HitFrame")return;
+    kind=next;hoster=owner;generation=epoch;received=now;
+  }
+  bool Confirm(Kind requested,uint32_t owner,uint64_t epoch,std::chrono::steady_clock::time_point now) const {
+    const auto age=now-received;
+    return kind==requested&&hoster==owner&&generation==epoch&&age>=std::chrono::steady_clock::duration::zero()
+      &&age<=std::chrono::milliseconds(1500);
+  }
+};
+}
diff --git a/server/cpp/server_guest_lib/aetherius_combat/ds5a/Bridge.h b/server/cpp/server_guest_lib/aetherius_combat/ds5a/Bridge.h
new file mode 100644
index 0000000000000000000000000000000000000000..2c6d831b5527c9c9a9b61f6ea041ce4be8d92922
--- /dev/null
+++ b/server/cpp/server_guest_lib/aetherius_combat/ds5a/Bridge.h
@@ -0,0 +1,181 @@
+#pragma once
+#include "Physical.h"
+#include "../forms/StableFormKey.h"
+#include <map>
+#include <memory>
+#include <set>
+#include <string>
+#include <functional>
+#include <nlohmann/json.hpp>
+
+namespace aetherius::combat::ds5a {
+using Json = nlohmann::json;
+inline StableFormKey Key(const std::string& text) {
+  const auto split=text.rfind('|');
+  if (split==std::string::npos) throw std::invalid_argument("expected plugin|XXXXXX");
+  return StableFormKey::Parse(text.substr(0,split)+":"+text.substr(split+1));
+}
+inline Skill ParseSkill(const std::string& value) {
+  for(unsigned i=0;i<SkillNames.size();++i) if(value==SkillNames[i])return static_cast<Skill>(i);
+  return Skill::None;
+}
+inline double Numeric(const Json& value,double max=1e7) {
+  if(!value.is_number())throw std::invalid_argument("numeric field absent");
+  const double n=value.get<double>();
+  if(!InRange(n,max))throw std::invalid_argument("numeric field invalid");
+  return n;
+}
+inline uint32_t RuntimeId(const Json& value) {
+  const double n=Numeric(value,4294967295.0);
+  if(n<1||std::floor(n)!=n)throw std::invalid_argument("runtime id invalid");
+  return static_cast<uint32_t>(n);
+}
+struct Record {
+  enum class Kind { Weapon, Armor, Ammo, Race } kind;
+  StableFormKey key;
+  bool supported=false, ranged=false, clothing=false;
+  double base=0, damageResist=0;
+  Skill skill=Skill::None;
+  Value criticalBase,itemType;
+  std::vector<StableFormKey> keywords;
+};
+struct Catalog {
+  Scaling scaling;
+  Value powerBonus;
+  std::map<uint32_t,Record> records;
+  std::map<StableFormKey,uint32_t> ids;
+};
+// Cache is a conversion of the Core projection, not another mutable ActorCombatState.
+// Ownership is weak. Maintenance is outside hits (publication/diagnostic reads).
+class Bridge {
+public:
+  using Resolver=std::function<uint32_t(const StableFormKey&)>;
+  using Hydrator=std::function<void(Catalog&)>;
+  explicit Bridge(Resolver resolver,Hydrator hydrate={}):resolve(std::move(resolver)),hydrate(std::move(hydrate)) {}
+  bool SetCatalog(const std::string& text) {
+    if(catalog && text==catalogText)return true;
+    if(catalog)return false; // accepted table is immutable for this host boot
+    try {
+      const auto j=Json::parse(text);
+      if(j.at("version")!=1)throw std::invalid_argument("catalog version");
+      auto next=std::make_shared<Catalog>();
+      const auto& gmst=j.at("gmsts");
+      auto setting=[&](const char* name){const auto& row=gmst.at(name);
+        if(resolve(Key(row.at("stableFormKey")))!=RuntimeId(row.at("runtimeId")))throw std::invalid_argument("gmst identity");
+        return Numeric(row.at("value"),100);};
+      next->scaling={setting("fDamagePCSkillMax"),setting("fArmorRatingBase"),setting("fArmorRatingPCMax")};
+      if(next->scaling.weaponMax<1||next->scaling.armorMax<next->scaling.armorBase)throw std::invalid_argument("gmst order");
+      const auto& rows=j.at("records");
+      if(!rows.is_array()||rows.empty()||rows.size()>100000)throw std::invalid_argument("catalog capacity");
+      for(const auto& row:rows) {
+        const auto key=Key(row.at("stableFormKey"));const auto id=RuntimeId(row.at("runtimeId"));
+        if(resolve(key)!=id||next->ids.count(key)||next->records.count(id))throw std::invalid_argument("catalog identity");
+        const auto type=row.at("type").get<std::string>();
+        Record rec{};rec.key=key;
+        if(type=="WEAP")rec.kind=Record::Kind::Weapon;
+        else if(type=="ARMO")rec.kind=Record::Kind::Armor;
+        else if(type=="AMMO")rec.kind=Record::Kind::Ammo;
+        else if(type=="RACE")rec.kind=Record::Kind::Race;
+        else throw std::invalid_argument("catalog record type");
+        rec.supported=row.at("status")=="SUPPORTED";
+        if(rec.supported) {
+          rec.base=Numeric(row.at("base"));
+          rec.skill=ParseSkill(row.at("skill"));
+          rec.ranged=row.at("ranged").get<bool>();rec.clothing=row.at("clothing").get<bool>();
+          rec.damageResist=Numeric(row.at("damageResist"));
+          const auto& keywords=row.at("keywords");
+          if(!keywords.is_array()||keywords.size()>512)throw std::invalid_argument("keywords");
+          for(const auto& keyword:keywords)rec.keywords.push_back(Key(keyword));
+          if(rec.kind==Record::Kind::Weapon && rec.skill!=Skill::OneHanded && rec.skill!=Skill::TwoHanded && rec.skill!=Skill::Marksman)
+            throw std::invalid_argument("weapon skill");
+          if(rec.kind==Record::Kind::Armor && !rec.clothing && rec.skill!=Skill::HeavyArmor && rec.skill!=Skill::LightArmor)
+            throw std::invalid_argument("armor skill");
+        }
+        next->ids.emplace(key,id);next->records.emplace(id,std::move(rec));
+      }
+      if(hydrate)hydrate(*next);
+      catalog=next;catalogText=text;catalogReason=Reason::None;return true;
+    }catch(...){catalogReason=Reason::CatalogInvalid;return false;}
+  }
+  struct Entry {
+    std::weak_ptr<void> actor;
+    uint64_t revision=0;
+    std::string raw;
+    Profile profile;
+  };
+  void Sweep() { for(auto i=profiles.begin();i!=profiles.end();)if(i->second.actor.expired())i=profiles.erase(i);else ++i; }
+  void RequestNpc(uint32_t id) {
+    for(size_t i=0;i<requestCount;++i)if(requests[i]==id)return;
+    if(requestCount<requests.size())requests[requestCount++]=id;
+  }
+  Json TakeRequests() { Json out=Json::array();for(size_t i=0;i<requestCount;++i)out.push_back(requests[i]);requestCount=0;return out; }
+  bool Publish(uint32_t id,const std::shared_ptr<void>& actor,uint64_t revision,const std::string& text,uint64_t generation=0,const StableFormKey* identity=nullptr) {
+    Sweep();
+    if(text=="null"){profiles.erase(id);return true;}
+    auto i=profiles.find(id);
+    if(i!=profiles.end() && i->second.actor.lock()==actor) {
+      if(i->second.revision==revision) {
+        if(i->second.raw==text)return i->second.profile.valid;
+        i->second.profile.valid=false;return false;
+      }
+      if(revision<i->second.revision){i->second.profile.valid=false;return false;}
+    }
+    if(profiles.size()>=4096 && i==profiles.end())return false;
+    Entry next{actor,revision,text,{}};next.profile.revision=revision;next.profile.npcGeneration=generation;
+    ++profileParses;
+    try {
+      const auto j=Json::parse(text);
+      if(j.at("version")!=1||Numeric(j.at("revision"),9007199254740991.0)!=revision||revision==0)throw std::invalid_argument("profile version/revision");
+      auto& p=next.profile;
+      const auto kind=j.at("subject").at("kind");
+      if(kind!="PLAYER"&&kind!="NPC")throw std::invalid_argument("profile subject");
+      p.player=kind=="PLAYER";
+      if(identity)p.identity=*identity;
+      else if(j.at("subject").contains("stableFormKey")&&j.at("subject").at("stableFormKey").is_string())p.identity=Key(j.at("subject").at("stableFormKey"));
+      p.perks=ds5b::ConvertPerks(j);
+      if(j.contains("attributes")) {
+        unsigned index=0;
+        for(const auto* name:{"health","magicka","stamina"}) {
+          const auto& attribute=j.at("attributes").at(name);
+          if(attribute.at("status")=="SUPPORTED")p.maxima[index]={true,Numeric(attribute.at("value"))};
+          ++index;
+        }
+      }
+      const auto& race=j.at("race");
+      if(race.at("status")=="SUPPORTED")p.race=resolve(Key(race.at("value")));
+      for(unsigned s=0;s<SkillNames.size();++s) {
+        const auto& value=j.at("skills").at(SkillNames[s]);
+        if(value.at("status")=="SUPPORTED")p.skills[s]={true,Numeric(value.at("value"),1000)};
+        else if(value.at("status")!="UNSUPPORTED")throw std::invalid_argument("skill status");
+      }
+      constexpr const char* effectNames[]={"fortifyOneHandedDamage","fortifyTwoHandedDamage","fortifyArcheryDamage","fortifyUnarmedDamage",
+        "fortifyPowerAttacks","fortifyBashDamage","fortifyArmorRating","fortifyBlock","resistArrowDamage","resistPowerAttackDamage","fortifySneakAttacks"};
+      for(unsigned e=0;e<11;++e) {
+        const auto& value=j.at("effects").at(effectNames[e]);
+        // No Q16 activation is certified in DS-5a. Even a future SUPPORTED value
+        // is explicitly ignored rather than silently applied twice.
+        if(value.at("status")!="INACTIVE")p.unsupportedEffects|=1u<<e;
+      }
+      p.valid=true;
+    }catch(...){next.profile.valid=false;}
+    const bool valid=next.profile.valid;profiles[id]=std::move(next);return valid;
+  }
+  const Profile* Get(uint32_t id,const void* actor) const {
+    const auto i=profiles.find(id);
+    if(i==profiles.end())return nullptr;
+    const auto owner=i->second.actor.lock();
+    return owner && owner.get()==actor ? &i->second.profile : nullptr;
+  }
+  size_t ProfileCount() { Sweep();return profiles.size(); }
+  uint64_t profileParses=0;
+  std::shared_ptr<const Catalog> catalog;
+  Reason catalogReason=Reason::CatalogAbsent;
+private:
+  Resolver resolve;
+  Hydrator hydrate;
+  std::string catalogText;
+  std::map<uint32_t,Entry> profiles;
+  std::array<uint32_t,2048> requests{};
+  size_t requestCount=0;
+};
+}

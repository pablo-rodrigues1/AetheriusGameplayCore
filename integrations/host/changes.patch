+  check(std::abs(h["damage"].get<float>() - 30.f) < 1e-4f, "hit damage from current chain");
+  check(std::abs(h["healthBefore"].get<float>() - 1.f) < 1e-4f &&
+          std::abs(h["healthAfter"].get<float>() - std::get<0>(on)) < 1e-4f,

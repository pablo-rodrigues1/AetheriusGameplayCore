index 0000000000000000000000000000000000000000..8d7e622f94d3bc59576e7850491efad224589164
--- /dev/null
+++ b/server/cpp/server_guest_lib/aetherius_combat/AetheriusDamageFormula.h
@@ -0,0 +1,32 @@
+#pragma once
+#include "formulas/IDamageFormula.h"
+#include "physical/PhysicalDamagePipeline.h"
+#include "ShadowStatus.h"
+#include <map>
+
+namespace espm { class CombineBrowser; }
+namespace aetherius::combat {
+// A6-S3 only. No actor state is installed or persisted. The zero profile is
+// explicit experimental input; its result is never applied by the host.
+class AetheriusDamageFormula final : public IDamageFormula {
+public:
+  static constexpr size_t kMaxEquipmentEntries = 64;
+  AetheriusDamageFormula(const espm::CombineBrowser& browser,
+    const std::vector<StableFormKey>& physicalRecords);
+  float CalculateDamage(const MpActor&, const MpActor&, const HitData&) const override;
+  float CalculateDamage(const MpActor&, const MpActor&, const SpellCastData&) const override;
+private:
+  enum class Kind { Weapon, Armor };
+  struct Record {
+    Kind kind;
+    double base;
+    const char* skill;
+    bool supported;
+  };
+  // Filled from winning host records at startup, then immutable on hits.
+  std::map<uint32_t, Record> records;
+  const CombatProfile neutralProfile{0, {}, {}, 0, 0, 0};
+  const CombatSettings settings{};
+  const PerkRegistry noPerks{};
+};
+}
diff --git a/server/cpp/server_guest_lib/aetherius_combat/DevAttributes.cpp b/server/cpp/server_guest_lib/aetherius_combat/DevAttributes.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..570243e2ae853858208ef5243bd1015ce1a21032
--- /dev/null
+++ b/server/cpp/server_guest_lib/aetherius_combat/DevAttributes.cpp
@@ -0,0 +1,95 @@
+#include "DevAttributes.h"
+#include "MpActor.h"
+#include "SpSnippet.h"
+#include "WorldState.h"
+
+bool MpActor::HasDevAttributes() const
+{
+  return aetheriusDevAttributes.has_value() && IsCreatedAsPlayer()
+    && GetUserId() != Networking::InvalidUserId
+    && GetUserId() == aetheriusDevAttributesUser;
+}
+
+void MpActor::ApplyDevAttributes(BaseActorValues& values) const
+{
+  if (HasDevAttributes()) aetheriusDevAttributes->Apply(values);
+}
+
+void MpActor::SetDevAttributes(
+  const std::optional<aetherius::development::Attributes>& attributes)
+{
+  if (attributes) {
+    attributes->Validate();
+    if (!IsCreatedAsPlayer() || GetUserId() == Networking::InvalidUserId
+        || GetProfileId() < 1)
+      throw std::invalid_argument("DEV attributes require an online player profile");
+  }
+  const bool hadValue = aetheriusDevAttributes.has_value();
+  aetheriusDevAttributes = attributes;
+  aetheriusDevAttributesUser = GetUserId();
+  ++aetheriusDevAttributesRevision;
+  if (!attributes && !hadValue) return;
+  if (!IsCreatedAsPlayer() || GetUserId() == Networking::InvalidUserId) return;
+
+  SendAttributeMaximumValues();
+}
+
+// AETHERIUS C3d: same delivery and ACK guards for the single effective maximum.
+void MpActor::SendAttributeMaximumValues()
+{
+  // Reuse the existing client Actor.SetActorValue bridge. Its ACK certifies
+  // completion of the calls only. Send percentages after all three ACKs so an
+  // old maximum cannot be used by the client's ChangeValues handler.
+  const auto values = GetMaximumValues();
+  const auto revision = aetheriusDevAttributesRevision;
+  const auto user = GetUserId();
+  const std::weak_ptr<MpForm> weak = GetParent()->LookupFormById(GetFormId());
+  const auto remaining = std::make_shared<int>(3);
+  const std::pair<const char*, float> resources[] = {
+    { "Health", values.health }, { "Magicka", values.magicka },
+    { "Stamina", values.stamina }
+  };
+  for (const auto& [name, value] : resources) {
+    const std::vector<std::optional<std::variant<bool, double, std::string,
+      SpSnippetObjectArgument>>> args = { std::string(name), double(value) };
+    SpSnippet("Actor", "SetActorValue", args, GetFormId())
+      .Execute(this, SpSnippetMode::kReturnResult)
+      .Then([weak, revision, user, remaining](VarValue) {
+        auto form = weak.lock();
+        auto actor = form ? form->AsActor() : nullptr;
+        if (!actor || actor->aetheriusDevAttributesRevision != revision
+            || actor->GetUserId() != user || actor->IsDisabled()) return;
+        if (--*remaining == 0)
+          actor->NetSendChangeValues(actor->GetActorValues(), std::nullopt);
+      });
+  }
+}
+
+bool MpActor::HasAttributeBonuses() const
+{
+  return aetheriusAttributeBonuses.has_value() && IsCreatedAsPlayer()
+    && GetUserId() != Networking::InvalidUserId
+    && GetUserId() == aetheriusAttributeBonusesUser
+    && GetProfileId() == aetheriusAttributeBonusesProfile;
+}
+
+void MpActor::SetAttributeBonuses(
+  const std::optional<aetherius::attributes::Bonuses>& bonuses)
+{
+  if (bonuses) {
+    bonuses->Validate();
+    if (!IsCreatedAsPlayer() || GetUserId() == Networking::InvalidUserId
+        || GetProfileId() < 1)
+      throw std::invalid_argument("ATTRIBUTE_OFFICIAL_PLAYER_REQUIRED");
+    if (HasDevAttributes())
+      throw std::invalid_argument("ATTRIBUTE_DEV_WRITER_ACTIVE");
+  }
+  const bool hadValue = aetheriusAttributeBonuses.has_value();
+  aetheriusAttributeBonuses = bonuses;
+  aetheriusAttributeBonusesUser = GetUserId();
+  aetheriusAttributeBonusesProfile = GetProfileId();
+  ++aetheriusDevAttributesRevision; // Shared maximum delivery invalidates old ACKs.
+  if (!bonuses && !hadValue) return;
+  if (!IsCreatedAsPlayer() || GetUserId() == Networking::InvalidUserId) return;
+  SendAttributeMaximumValues();
+}
diff --git a/server/cpp/server_guest_lib/aetherius_combat/DevAttributes.h b/server/cpp/server_guest_lib/aetherius_combat/DevAttributes.h
new file mode 100644
index 0000000000000000000000000000000000000000..4da5040960c02045c2596baf570060b64609698e
--- /dev/null
+++ b/server/cpp/server_guest_lib/aetherius_combat/DevAttributes.h
@@ -0,0 +1,44 @@
+#pragma once
+#include "GetBaseActorValues.h"
+#include <optional>
+#include <stdexcept>
+
+// AETHERIUS DEV-A1: transient resource maxima, never a change form or gameplay rule.
+namespace aetherius::development {
+struct Attributes {
+  int health;
+  int magicka;
+  int stamina;
+  void Validate() const {
+    for (const auto value : { health, magicka, stamina })
+      if (value < 1 || value > 100000)
+        throw std::invalid_argument("DEV attributes outside 1..100000");
+  }
+  void Apply(BaseActorValues& values) const {
+    values.health = static_cast<float>(health);
+    values.magicka = static_cast<float>(magicka);
+    values.stamina = static_cast<float>(stamina);
+  }
+};
+}
+
+// AETHERIUS C3d: normal server-authoritative additive allocation.
+namespace aetherius::attributes {
+struct Bonuses {
+  int health;
+  int magicka;
+  int stamina;
+  void Validate() const {
+    for (const auto value : { health, magicka, stamina })
+      if (value < 0 || value > 585 || value % 5 != 0)
+        throw std::invalid_argument("ATTRIBUTE_POINTS_INVALID");
+    if (health + magicka + stamina > 585)
+      throw std::invalid_argument("ATTRIBUTE_POINTS_INVALID");
+  }
+  void Apply(BaseActorValues& values) const {
+    values.health += static_cast<float>(health);
+    values.magicka += static_cast<float>(magicka);
+    values.stamina += static_cast<float>(stamina);
+  }
+};
+}

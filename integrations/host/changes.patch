+
+TEST_CASE("ActionListener rejects without advancing anchor or accepted timestamp and recovers", "[NpcMovementCorrection]")
+{
+  MovementFixture f;
+  ProbeGuard guard;
+  f.Movement(0);
+  const auto idx = f.Npc().GetIdx();

diff --git a/server/cpp/server_guest_lib/aetherius_combat/forms/StableFormKey.h b/server/cpp/server_guest_lib/aetherius_combat/forms/StableFormKey.h
new file mode 100644
index 0000000000000000000000000000000000000000..4671fc45414d28da94959e45b464b9fd224daa3b
--- /dev/null
+++ b/server/cpp/server_guest_lib/aetherius_combat/forms/StableFormKey.h
@@ -0,0 +1,41 @@
+#pragma once
+#include <algorithm>
+#include <cctype>
+#include <cstdint>
+#include <iomanip>
+#include <sstream>
+#include <stdexcept>
+#include <string>
+
+namespace aetherius::combat {
+struct StableFormKey {
+  std::string plugin;
+  uint32_t localId = 0;
+  static StableFormKey Parse(const std::string& text) {
+    const auto colon = text.rfind(':');
+    if (colon == std::string::npos || text.size() - colon - 1 != 6)
+      throw std::invalid_argument("StableFormKey requires plugin:XXXXXX");
+    auto file = text.substr(0, colon);
+    std::transform(file.begin(), file.end(), file.begin(),
+      [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+    const auto dot = file.rfind('.');
+    if (dot == std::string::npos ||
+        (file.substr(dot) != ".esp" && file.substr(dot) != ".esm" && file.substr(dot) != ".esl") ||
+        file.find_first_of("/\\:") != std::string::npos)
+      throw std::invalid_argument("invalid plugin filename");
+    const auto hex = text.substr(colon + 1);
+    if (!std::all_of(hex.begin(), hex.end(), [](unsigned char c) { return std::isxdigit(c); }))
+      throw std::invalid_argument("invalid local FormID");
+    const auto id = static_cast<uint32_t>(std::stoul(hex, nullptr, 16));
+    if (!id) throw std::invalid_argument("null local FormID");
+    return {file, id};
+  }
+  std::string ToString() const {
+    std::ostringstream out;
+    out << plugin << ':' << std::uppercase << std::hex << std::setw(6) << std::setfill('0') << localId;
+    return out.str();
+  }
+  bool operator==(const StableFormKey& r) const { return plugin == r.plugin && localId == r.localId; }
+  bool operator<(const StableFormKey& r) const { return plugin < r.plugin || (plugin == r.plugin && localId < r.localId); }
+};
+}
diff --git a/server/cpp/server_guest_lib/aetherius_combat/perks/PerkRegistry.h b/server/cpp/server_guest_lib/aetherius_combat/perks/PerkRegistry.h
new file mode 100644
index 0000000000000000000000000000000000000000..ec915b30d4a560b08abaf83b961b968d2b42e16e
--- /dev/null
+++ b/server/cpp/server_guest_lib/aetherius_combat/perks/PerkRegistry.h
@@ -0,0 +1,79 @@
+#pragma once
+#include "../context/DamageContext.h"
+#include <functional>
+namespace aetherius::combat {
+struct PerkCondition { std::string function; StableFormKey key; bool expected = true; bool orNext = false; };
+struct PerkHandler {
+  StableFormKey key;
+  std::string editorId, winner, entryPoint, skill;
+  double coefficient = 0;
+  std::vector<std::vector<PerkCondition>> conditions;
+  bool Matches(const CombatProfile& profile, const std::vector<StableFormKey>& keywords) const {
+    for (const auto& group : conditions) {
+      bool disjunction = false;
+      for (const auto& c : group) {
+        bool actual = false;
+        if (c.function == "HasPerk") actual = profile.Has(c.key);
+        else if (c.function == "HasKeyword") actual = std::find(keywords.begin(),keywords.end(),c.key) != keywords.end();
+        else return false;
+        disjunction = disjunction || (actual == c.expected);
+        if (!c.orNext) { if (!disjunction) return false; disjunction = false; }
+      }
+      // Bethesda permits a terminal OR flag; it still terminates this group.
+      if (!group.empty() && group.back().orNext && !disjunction) return false;
+    }
+    return true;
+  }
+};
+class PerkRegistry {
+public:
+  void Load(const nlohmann::json& catalog) {
+    if (catalog.at("schemaVersion") != 1) throw std::invalid_argument("invalid perk catalog");
+    std::map<StableFormKey,std::vector<PerkHandler>> next;
+    for (const auto& row : catalog.at("perks")) {
+      auto key = StableFormKey::Parse(row.at("key").get<std::string>());
+      if (next.count(key)) throw std::invalid_argument("duplicate catalog key");
+      for (const auto& effect : row.at("effects")) {
+        PerkHandler h; h.key = key; h.editorId = row.at("editorId"); h.winner = row.at("winner");
+        h.entryPoint = effect.at("entryPoint"); h.skill = effect.at("skill");
+        if (!Skills().count(h.skill)) throw std::invalid_argument("unknown handler skill");
+        if (h.entryPoint != "CalculateWeaponDamage" && h.entryPoint != "ModAttackDamage" &&
+            h.entryPoint != "CalculateMyCriticalHitDamage" && h.entryPoint != "ModArmorRating" && h.entryPoint != "ModPercentBlocked")
+          throw std::invalid_argument("unsupported entry point");
+        h.coefficient = Number(effect,"coefficient",0,1);
+        for (const auto& group : effect.at("conditions")) {
+          std::vector<PerkCondition> conditions;
+          for (const auto& c : group) {
+            auto f = c.at("function").get<std::string>();
+            if (f != "HasKeyword" && f != "HasPerk") throw std::invalid_argument("unsupported condition");
+            conditions.push_back({f,StableFormKey::Parse(c.at("key")),c.at("expected").get<bool>(),c.at("orNext").get<bool>()});
+          }
+          h.conditions.push_back(std::move(conditions));
+        }
+        next[key].push_back(std::move(h));
+      }
+    }
+    handlers = std::move(next);
+  }
+  bool Supports(const StableFormKey& key) const { return handlers.count(key) != 0; }
+  void Validate(const CombatProfile& p) const {
+    for (const auto& grant : p.perks)
+      if (!Supports(grant.key) || grant.rank != 1) throw std::invalid_argument("unsupported perk/rank " + grant.key.ToString());
+  }
+  double Multiplier(const std::string& point, const CombatProfile& p,
+                    const std::vector<StableFormKey>& keywords, CombatTrace& trace) const {
+    double multiplier = 1;
+    for (const auto& grant : p.perks) {
+      const auto found = handlers.find(grant.key);
+      if (found == handlers.end()) continue;
+      for (const auto& h : found->second) if (h.entryPoint == point && h.Matches(p,keywords)) {
+        const auto m = 1 + h.coefficient * p.Skill(h.skill);
+        multiplier *= m; trace.Add("perk."+point,m,h.key.ToString());
+      }
+    }
+    return multiplier;
+  }
+private:
+  std::map<StableFormKey,std::vector<PerkHandler>> handlers;
+};
+}
diff --git a/server/cpp/server_guest_lib/aetherius_combat/physical/ArmorCurve.h b/server/cpp/server_guest_lib/aetherius_combat/physical/ArmorCurve.h
new file mode 100644
index 0000000000000000000000000000000000000000..9cdcb3c51c0ef2534185b43732674cedbc5b0a15
--- /dev/null
+++ b/server/cpp/server_guest_lib/aetherius_combat/physical/ArmorCurve.h
@@ -0,0 +1,11 @@
+#pragma once
+#include "../config/CombatSettings.h"
+namespace aetherius::combat {
+inline double ArmorReduction(double armor, const CombatSettings& s = {}) {
+  if (!std::isfinite(armor)) throw std::invalid_argument("nonfinite armor");
+  if (armor <= 0) return 0;
+  if (armor <= s.softRating) return armor * s.softReduction / s.softRating;
+  if (armor >= s.hardRating) return s.hardReduction;
+  return s.softReduction + (armor-s.softRating) * (s.hardReduction-s.softReduction) / (s.hardRating-s.softRating);
+}
+}
diff --git a/server/cpp/server_guest_lib/aetherius_combat/physical/PhysicalDamagePipeline.h b/server/cpp/server_guest_lib/aetherius_combat/physical/PhysicalDamagePipeline.h
new file mode 100644
index 0000000000000000000000000000000000000000..1d52d73e4b6c093bd6a977d98e7ae8c7828b8edc
--- /dev/null
+++ b/server/cpp/server_guest_lib/aetherius_combat/physical/PhysicalDamagePipeline.h
@@ -0,0 +1,43 @@
+#pragma once
+#include "ArmorCurve.h"
+#include "../perks/PerkRegistry.h"
+namespace aetherius::combat {
+inline double Nonnegative(double v) {
+  if (!std::isfinite(v)) throw std::invalid_argument("nonfinite damage component");
+  return std::max(0.0,v);
+}
+inline double BlockReduction(const CombatProfile& defender, const PerkRegistry& perks,
+                             const CombatSettings& settings, CombatTrace& trace) {
+  const double base = settings.blockBase + settings.blockPerSkill * defender.Skill("Block");
+  const double multiplier = perks.Multiplier("ModPercentBlocked",defender,{},trace);
+  return std::clamp(base*multiplier,0.0,settings.blockCap);
+}
+inline double ArmorPiece(double base, const std::string& skill, const CombatProfile& profile,
+                         const std::vector<StableFormKey>& keywords, double flat, double itemMultiplier,
+                         const PerkRegistry& perks, const CombatSettings& settings, CombatTrace& trace) {
+  const double rating = Nonnegative(base+flat) * Nonnegative(itemMultiplier) *
+    (1 + .005 * profile.Skill(skill)) * perks.Multiplier("ModArmorRating",profile,keywords,trace);
+  trace.Add("armor.piece",rating);
+  return rating + settings.hiddenArmorPerPiece;
+}
+inline DamageResult PhysicalDamage(const DamageContext& c, const CombatSettings& s,
+                                   const PerkRegistry& perks, CombatRng& rng, CombatTrace& trace) {
+  const double skill = c.attacker.Skill(c.weaponSkill);
+  trace.Add("weapon.base",c.weaponBase); trace.Add("skill."+c.weaponSkill,skill);
+  double damage = Nonnegative(c.weaponBase+c.flatItemDamage) * Nonnegative(c.itemMultiplier) * (1+.005*skill);
+  damage *= perks.Multiplier("CalculateWeaponDamage",c.attacker,c.weaponKeywords,trace);
+  damage *= perks.Multiplier("ModAttackDamage",c.attacker,c.weaponKeywords,trace);
+  damage *= Nonnegative(c.attackMultiplier);
+  // Critical base comes from the authorized weapon resolver, not the packet.
+  if (rng.Roll(c.criticalChance)) {
+    const auto critical = Nonnegative(c.criticalBase) * perks.Multiplier("CalculateMyCriticalHitDamage",c.attacker,c.weaponKeywords,trace);
+    damage += critical; trace.Add("critical.component",critical);
+  }
+  damage *= s.physicalMultiplier; trace.Add("physical.preDefense",damage);
+  const auto block = c.blocked ? BlockReduction(c.defender,perks,s,trace) : 0;
+  const auto armor = ArmorReduction(c.armor,s);
+  trace.Add("block.reduction",block); trace.Add("armor.effective",c.armor); trace.Add("armor.reduction",armor);
+  damage = Nonnegative(damage*(1-block)*(1-armor)); trace.Add("physical.final",damage);
+  return {damage,0,0,false};
+}
+}
diff --git a/server/cpp/server_guest_lib/aetherius_combat/state/ActorCombatState.h b/server/cpp/server_guest_lib/aetherius_combat/state/ActorCombatState.h
new file mode 100644
index 0000000000000000000000000000000000000000..43a3234868991bb1e4a7004d9a5a7ff34efaecd8
--- /dev/null
+++ b/server/cpp/server_guest_lib/aetherius_combat/state/ActorCombatState.h
@@ -0,0 +1,67 @@
+#pragma once
+#include "../forms/StableFormKey.h"
+#include "../config/CombatSettings.h"
+#include <map>
+#include <set>
+#include <vector>
+
+namespace aetherius::combat {
+inline const std::set<std::string>& Skills() {
+  static const std::set<std::string> names = {"OneHanded","TwoHanded","Marksman","Block","HeavyArmor","LightArmor","Sneak","Destruction","Alteration","Restoration","Conjuration","Illusion","Alchemy","Enchanting","Smithing","Lockpicking","Speechcraft","Pickpocket"};
+  return names;
+}
+struct PerkGrant { StableFormKey key; unsigned rank = 1; };
+struct CombatProfile {
+  uint64_t revision = 0;
+  std::map<std::string,double> skills;
+  std::vector<PerkGrant> perks;
+  double health = 100, magicka = 100, stamina = 100;
+  double Skill(const std::string& name) const {
+    const auto it = skills.find(name); return it == skills.end() ? 0 : it->second;
+  }
+  bool Has(const StableFormKey& key) const {
+    for (const auto& p : perks) if (p.key == key) return true;
+    return false;
+  }
+  static CombatProfile FromJson(const nlohmann::json& j) {
+    ExactKeys(j,{"schemaVersion","revision","skills","perks","baseAttributes"});
+    if (!j.at("schemaVersion").is_number_integer() || j.at("schemaVersion") != 1)
+      throw std::invalid_argument("unsupported CombatProfile schema");
+    if (!j.at("revision").is_number_integer()) throw std::invalid_argument("revision must be integer");
+    CombatProfile p;
+    p.revision = static_cast<uint64_t>(Number(j,"revision",1,9007199254740991.0));
+    if (!j.at("skills").is_object()) throw std::invalid_argument("skills must be object");
+    for (const auto& item : j.at("skills").items()) {
+      if (!Skills().count(item.key())) throw std::invalid_argument("unknown skill " + item.key());
+      p.skills[item.key()] = Number(j.at("skills"),item.key().c_str(),0,100);
+    }
+    if (!j.at("perks").is_array() || j.at("perks").size() > 512) throw std::invalid_argument("invalid perks");
+    std::set<StableFormKey> seen;
+    for (const auto& perk : j.at("perks")) {
+      ExactKeys(perk,{"key","rank","source"});
+      if (perk.at("source") != "CLASS" || !perk.at("rank").is_number_integer()) throw std::invalid_argument("invalid perk grant");
+      auto key = StableFormKey::Parse(perk.at("key").get<std::string>());
+      if (!seen.insert(key).second) throw std::invalid_argument("duplicate perk");
+      p.perks.push_back({key,static_cast<unsigned>(Number(perk,"rank",1,255))});
+    }
+    const auto& a = j.at("baseAttributes"); ExactKeys(a,{"health","magicka","stamina"});
+    p.health = Number(a,"health",1,1000000); p.magicka = Number(a,"magicka",1,1000000); p.stamina = Number(a,"stamina",1,1000000);
+    return p;
+  }
+  nlohmann::json ToJson() const {
+    nlohmann::json grants = nlohmann::json::array();
+    for (const auto& p : perks) grants.push_back({{"key",p.key.ToString()},{"rank",p.rank},{"source","CLASS"}});
+    return {{"schemaVersion",1},{"revision",revision},{"skills",skills},{"perks",grants},{"baseAttributes",{{"health",health},{"magicka",magicka},{"stamina",stamina}}}};
+  }
+};
+struct CombatRevision { uint64_t profile = 0, equipment = 0, effects = 0, providers = 0; };
+struct ActorCombatState {
+  CombatProfile profile;
+  CombatRevision revision;
+  // Validated on the server thread before publication. All absent skills become zero.
+  bool Apply(CombatProfile incoming) {
+    if (incoming.revision <= profile.revision) return false;
+    profile = std::move(incoming); revision.profile = profile.revision; return true;
+  }
+};
+}
diff --git a/server/cpp/server_guest_lib/formulas/ShadowDamageFormula.h b/server/cpp/server_guest_lib/formulas/ShadowDamageFormula.h
new file mode 100644
index 0000000000000000000000000000000000000000..4922778a6aaa0d972294c53bb620cdfa352bee9d
--- /dev/null
+++ b/server/cpp/server_guest_lib/formulas/ShadowDamageFormula.h
@@ -0,0 +1,88 @@
+#pragma once
+#include "IDamageFormula.h"
+#include "aetherius_combat/ShadowStatus.h"
+#include <array>
+#include <cmath>
+#include <memory>
+#include <nlohmann/json.hpp>
+
+// All methods run on the host's server thread. Read outside CalculateDamage;
+// concurrent readers would require synchronization before using this API.
+class ShadowDamageFormula final : public IDamageFormula {
+public:
+  static constexpr size_t kCapacity = 1024;
+  enum class Status { Calculated, Unsupported, Exception, Invalid };
+  struct Sample {
+    uint64_t sequence = 0;
+    HitData hit{};
+    float current = 0, candidate = 0;
+    bool neutralProfile = true;
+    Status status = Status::Calculated;
+    aetherius::combat::UnsupportedReason reason = aetherius::combat::UnsupportedReason::None;
+  };
+  struct Buffer {
+    std::array<Sample, kCapacity> samples{};
+    uint64_t hits = 0, failures = 0, exceptions = 0, invalid = 0, unsupported = 0;
+    size_t size = 0, next = 0;
+    // JSON/string allocation is confined to this explicitly requested read.
+    nlohmann::json Read() const {
+      auto rows = nlohmann::json::array();
+      for (size_t i = 0; i < size; ++i) {
+        const auto& s = samples[(next + kCapacity - size + i) % kCapacity];
+        rows.push_back({{"sequence", s.sequence}, {"aggressor", s.hit.aggressor},
+          {"target", s.hit.target}, {"source", s.hit.source}, {"projectile", s.hit.projectile},
+          {"power", s.hit.isPowerAttack}, {"blocked", s.hit.isHitBlocked},
+          {"sneak", s.hit.isSneakAttack}, {"bash", s.hit.isBashAttack},
+          {"current", s.current}, {"candidate", s.status == Status::Calculated
+            ? nlohmann::json(s.candidate) : nlohmann::json(nullptr)},
+          {"neutralProfile", s.neutralProfile},
+          {"status", s.status == Status::Calculated ? "CALCULATED" :
+            s.status == Status::Unsupported ? "UNSUPPORTED" :
+            s.status == Status::Exception ? "EXCEPTION" : "INVALID"},
+          {"unsupportedReason", static_cast<int>(s.reason)}});
+      }
+      return {{"capacity", kCapacity}, {"hits", hits}, {"failures", failures},
+        {"exceptions", exceptions}, {"invalid", invalid}, {"unsupported", unsupported},
+        {"overwritten", hits - size}, {"profile", "NEUTRAL_SHADOW_ONLY"},
+        {"samples", std::move(rows)}};
+    }
+  };
+  ShadowDamageFormula(std::unique_ptr<IDamageFormula> current,
+    std::unique_ptr<IDamageFormula> candidate, std::shared_ptr<Buffer> buffer)
+    : current(std::move(current)), candidate(std::move(candidate)), buffer(std::move(buffer)) {
+    if (!this->current || !this->candidate || !this->buffer)
+      throw std::invalid_argument("shadow requires both formulas and buffer");
+  }
+  float CalculateDamage(const MpActor& attacker, const MpActor& defender,
+    const HitData& hit) const override {
+    const float applied = current->CalculateDamage(attacker, defender, hit);
+    Sample sample{};
+    sample.sequence = ++buffer->hits;
+    sample.hit = hit;
+    sample.current = applied;
+    try {
+      sample.candidate = candidate->CalculateDamage(attacker, defender, hit);
+      if (!std::isfinite(sample.candidate) || sample.candidate < 0) {
+        sample.status = Status::Invalid;
+        ++buffer->failures; ++buffer->invalid;
+      }
+    } catch (const aetherius::combat::ShadowUnsupported& e) {
+      sample.status = Status::Unsupported; sample.reason = e.reason;
+      ++buffer->unsupported;
+    } catch (...) {
+      sample.status = Status::Exception;
+      ++buffer->failures; ++buffer->exceptions;
+    }
+    buffer->samples[buffer->next] = sample;
+    buffer->next = (buffer->next + 1) % kCapacity;
+    if (buffer->size < kCapacity) ++buffer->size;
+    return applied;
+  }
+  float CalculateDamage(const MpActor& attacker, const MpActor& defender,
+    const SpellCastData& spell) const override {
+    return current->CalculateDamage(attacker, defender, spell);
+  }
+private:
+  std::unique_ptr<IDamageFormula> current, candidate;
+  std::shared_ptr<Buffer> buffer;
+};
diff --git a/unit/AetheriusShadowTest.cpp b/unit/AetheriusShadowTest.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..4b62bc1c67c86761105917762aa19308f92d56e3
--- /dev/null
+++ b/unit/AetheriusShadowTest.cpp
@@ -0,0 +1,274 @@
+#include "PartOne.h"
+#include "MpActor.h"
+#include "aetherius_combat/AetheriusDamageFormula.h"
+#include "formulas/ShadowDamageFormula.h"
+#include "formulas/TES5DamageFormula.h"
+#include "formulas/DamageMultFormula.h"
+#include "formulas/SweetPieDamageFormula.h"
+#include "formulas/SweetPieSpellDamageFormula.h"
+#include "formulas/DamageMultConditionalFormula.h"
+#include "condition_functions/ConditionFunctionFactory.h"
+#include <chrono>
+#include <fstream>
+#include <iostream>
+#include <limits>
+
+namespace {
+int checks = 0;
+void Check(bool ok, const char* why) {
+  ++checks;
+  if (!ok) throw std::runtime_error(why);
+}
+void Near(float actual, float expected, const char* why) {
+  Check(std::abs(actual - expected) < 0.00001f, why);
+}
+std::unique_ptr<IDamageFormula> Legacy() {
+  std::unique_ptr<IDamageFormula> formula = std::make_unique<TES5DamageFormula>();
+  formula = std::make_unique<DamageMultFormula>(std::move(formula),
+    nlohmann::json{{"multiplier", 1}});
+  formula = std::make_unique<SweetPieDamageFormula>(std::move(formula), nullptr);
+  formula = std::make_unique<SweetPieSpellDamageFormula>(std::move(formula), nullptr);
+  formula = std::make_unique<DamageMultConditionalFormula>(std::move(formula),
+    nullptr, nullptr, std::make_shared<ConditionFunctionMap>(
+      ConditionFunctionFactory::CreateConditionFunctions()));
+  return formula;
+}
+class FaultFormula final : public IDamageFormula {
+public:
+  explicit FaultFormula(int fault) : fault(fault) {}
+  float CalculateDamage(const MpActor&, const MpActor&, const HitData&) const override {
+    if (fault == 0) throw std::runtime_error("injected candidate exception");
+    if (fault == 1) return std::numeric_limits<float>::quiet_NaN();
+    if (fault == 2) return std::numeric_limits<float>::infinity();
+    if (fault == 3) return -1;
+    if (fault == 4) throw 7; // A non-std exception must also stay isolated.
+    return 12;
+  }
+  float CalculateDamage(const MpActor&, const MpActor&, const SpellCastData&) const override {
+    if (fault == 5) return 17;
+    throw std::runtime_error("magic candidate must not run");
+  }
+private:
+  int fault;
+};
+Inventory::Entry Worn(uint32_t id) {
+  Inventory::Entry entry(id, 1);
+  entry.SetWorn(Inventory::Worn::Right);
+  return entry;
+}
+
+void Run(const std::filesystem::path& manifestPath) {
+  std::cout << std::unitbuf;
+  std::ifstream in(manifestPath);
+  nlohmann::json manifest;
+  in >> manifest;
+  std::vector<std::filesystem::path> paths;
+  for (const auto& row : manifest.at("plugins"))
+    paths.push_back(manifestPath.parent_path() / row.at("filename").get<std::string>());
+  espm::Loader loader(paths);
+  std::cout << "Host load order: " << paths.size() << " plugins\n";
+  PartOne host;
+  host.AttachEspm(&loader);
+  host.CreateActor(0xff000001, {0, 0, 0}, 0, 0x3c);
+  host.CreateActor(0xff000002, {0, 0, 0}, 0, 0x3c);
+  auto& attacker = host.worldState.GetFormAt<MpActor>(0xff000001);
+  auto& defender = host.worldState.GetFormAt<MpActor>(0xff000002);
+  Equipment equipment;
+  equipment.inv.entries.push_back(Worn(0x1397e));
+  attacker.SetEquipment(equipment);
+  Equipment armor;
+  armor.inv.entries.push_back(Worn(0x12e46));
+  defender.SetEquipment(armor);
+  const auto& browser = loader.GetBrowser();
+  auto& cache = browser.GetCache();
+  const auto weaponData = espm::Convert<espm::WEAP>(browser.LookupById(0x1397e).rec)->GetData(cache);
+  const auto armorData = espm::Convert<espm::ARMO>(browser.LookupById(0x12e46).rec)->GetData(cache);
+  const auto rating = armorData.baseRatingX100 / 100.0;
+  const float weaponBase = static_cast<float>(weaponData.weapData->damage);
+  std::cout << "Winner facts: dagger=" << weaponBase << " gauntlets=" << rating << '\n';
+  Check(!armorData.enchantmentFormId, "fixture must be unenchanted winning armor");
+  auto before = Legacy();
+  auto off = Legacy();
+  auto buffer = std::make_shared<ShadowDamageFormula::Buffer>();
+  ShadowDamageFormula on(Legacy(),
+    std::make_unique<aetherius::combat::AetheriusDamageFormula>(browser,
+      std::vector<aetherius::combat::StableFormKey>{
+        aetherius::combat::StableFormKey::Parse("Skyrim.esm:01397E"),
+        aetherius::combat::StableFormKey::Parse("Skyrim.esm:012E46")}), buffer);
+  const auto scaling = espm::GetData<espm::GMST>(espm::GMST::kFArmorScalingFactor, &host.worldState).value;
+  const auto maxArmor = espm::GetData<espm::GMST>(espm::GMST::kFMaxArmorRating, &host.worldState).value;
+  HitData hit{};
+  hit.aggressor = attacker.GetFormId(); hit.target = defender.GetFormId();
+  hit.source = 0x1397e;
+  // All eight power/block/sneak combinations, with native Block off and on.
+  for (bool nativeBlock : {false, true}) {
+    defender.SetIsBlockActive(nativeBlock);
+    for (int flags = 0; flags < 8; ++flags) {
+      hit.isPowerAttack = (flags & 1) != 0;
+      hit.isHitBlocked = (flags & 2) != 0;
+      hit.isSneakAttack = (flags & 4) != 0;
+      float golden = weaponBase * .01f * (100.f - std::min(
+        static_cast<float>(rating) * scaling, maxArmor));
+      if (hit.isPowerAttack) golden *= 2.f;
+      if (hit.isHitBlocked) golden *= .1f;
+      if (hit.isSneakAttack) golden *= 1.3f;
+      const auto original = before->CalculateDamage(attacker, defender, hit);
+      Near(original, golden, "legacy flag golden changed");
+      Check(off->CalculateDamage(attacker, defender, hit) == original, "off differs from original chain");
+      Check(on.CalculateDamage(attacker, defender, hit) == original, "shadow changed applied damage");
+      const auto& sample = buffer->samples[buffer->next - 1];
+      Check(sample.status == ShadowDamageFormula::Status::Calculated, "candidate not calculated");
+      const float candidate = static_cast<float>(weaponBase * (1 - rating * .8 / 500) *
+        (hit.isHitBlocked && nativeBlock ? .8 : 1));
+      Near(sample.candidate, candidate, "candidate physical golden changed");
+      Check(sample.neutralProfile && sample.hit.isPowerAttack == hit.isPowerAttack &&
+        sample.hit.isHitBlocked == hit.isHitBlocked && sample.hit.isSneakAttack == hit.isSneakAttack,
+        "sample context missing");
+      std::cout << "flags=" << flags << " nativeBlock=" << nativeBlock
+        << " off=" << original << " returned=" << sample.current
+        << " candidate=" << sample.candidate << " neutral=true\n";
+    }
+  }
+  std::cout << "BEGIN outside-hit snapshot; size=" << buffer->size << " next=" << buffer->next << '\n';
+  const auto initialSnapshot = buffer->Read();
+  std::cout << "Outside-hit snapshot: " << initialSnapshot.dump() << '\n';
+  hit.isPowerAttack = hit.isHitBlocked = hit.isSneakAttack = false;
+  const auto baseline = before->CalculateDamage(attacker, defender, hit);
+  for (int fault = 0; fault < 5; ++fault) {
+    auto failures = std::make_shared<ShadowDamageFormula::Buffer>();
+    ShadowDamageFormula shadow(Legacy(), std::make_unique<FaultFormula>(fault), failures);
+    Check(shadow.CalculateDamage(attacker, defender, hit) == baseline, "fault changed applied result");
+    Check(failures->failures == 1 && failures->hits == 1, "failure counter missing");
+    Check(failures->invalid == (fault >= 1 && fault <= 3 ? 1u : 0u), "invalid counter");
+    Check(failures->exceptions == (fault == 0 || fault == 4 ? 1u : 0u), "exception counter");
+    Check(failures->Read()["samples"][0]["candidate"].is_null(), "failed candidate must be null");
+    std::cout << "Fault " << fault << ": " << failures->Read().dump() << '\n';
+  }
+  auto currentFailures = std::make_shared<ShadowDamageFormula::Buffer>();
+  ShadowDamageFormula failedCurrent(std::make_unique<FaultFormula>(0),
+    std::make_unique<FaultFormula>(5), currentFailures);
+  bool threw = false;
+  try { (void)failedCurrent.CalculateDamage(attacker, defender, hit); } catch (...) { threw = true; }
+  Check(threw && currentFailures->hits == 0, "current exception must retain original behavior");
+
+  // Real candidate rejects incomplete input without applying an invented value.
+  equipment.inv.entries.clear(); attacker.SetEquipment(equipment);
+  Check(on.CalculateDamage(attacker, defender, hit) == baseline, "unsupported source changed current");
+  Check(buffer->samples[buffer->next - 1].reason == aetherius::combat::UnsupportedReason::SourceNotEquipped,
+    "source not equipped reason");
+  equipment.inv.entries.push_back(Worn(0x1397e)); attacker.SetEquipment(equipment);
+  armor.inv.entries[0].enchantmentId = 1; defender.SetEquipment(armor);
+  Check(on.CalculateDamage(attacker, defender, hit) == baseline, "unsupported enchanted armor changed current");
+  Check(buffer->samples[buffer->next - 1].reason == aetherius::combat::UnsupportedReason::EnchantedArmor,
+    "enchanted armor reason");
+  armor.inv.entries[0].enchantmentId.reset(); defender.SetEquipment(armor);
+  equipment.inv.entries.resize(65); attacker.SetEquipment(equipment);
+  Check(on.CalculateDamage(attacker, defender, hit) == baseline, "equipment limit changed current");
+  Check(buffer->samples[buffer->next - 1].reason == aetherius::combat::UnsupportedReason::EquipmentCapacity,
+    "equipment capacity reason");
+  equipment.inv.entries.resize(1); attacker.SetEquipment(equipment);
+  equipment.inv.entries.push_back(Worn(0x1397e)); attacker.SetEquipment(equipment);
+  Check(on.CalculateDamage(attacker, defender, hit) == baseline, "duplicate weapon changed current");
+  Check(buffer->samples[buffer->next - 1].reason == aetherius::combat::UnsupportedReason::DuplicateWeapon,
+    "duplicate equipped weapon reason");
+  equipment.inv.entries.resize(1);
+  equipment.inv.entries[0] = Worn(0x12eb7); attacker.SetEquipment(equipment);
+  hit.source = 0x12eb7;
+  const auto unprepared = before->CalculateDamage(attacker, defender, hit);
+  Check(on.CalculateDamage(attacker, defender, hit) == unprepared, "missing prepared record changed current");
+  Check(buffer->samples[buffer->next - 1].reason == aetherius::combat::UnsupportedReason::MissingRecord,
+    "missing prepared record reason");
+  equipment.inv.entries[0] = Worn(0x1397e); attacker.SetEquipment(equipment);
+  hit.source = 0x1f4;
+  const auto unarmed = before->CalculateDamage(attacker, defender, hit);
+  Check(on.CalculateDamage(attacker, defender, hit) == unarmed, "unarmed changed current");
+  Check(buffer->samples[buffer->next - 1].reason == aetherius::combat::UnsupportedReason::UnarmedRaceSnapshot,
+    "unarmed needs bounded race context");
+  hit.source = 0x1397e;
+  auto ring = std::make_shared<ShadowDamageFormula::Buffer>();
+  ShadowDamageFormula bounded(Legacy(), std::make_unique<FaultFormula>(5), ring);
+  for (size_t i = 0; i < ShadowDamageFormula::kCapacity + 17; ++i)
+    (void)bounded.CalculateDamage(attacker, defender, hit);
+  const auto ringJson = ring->Read();
+  Check(ring->size == ShadowDamageFormula::kCapacity && ring->hits == ShadowDamageFormula::kCapacity + 17,
+    "ring grew beyond fixed capacity");
+  Check(ringJson["overwritten"] == 17 && ringJson["samples"][0]["sequence"] == 18 &&
+    ringJson["samples"].back()["sequence"] == ring->hits, "ring order/overwrite incorrect");
+  std::cout << "Fixed buffer bytes=" << sizeof(ShadowDamageFormula::Buffer)
+    << " capacity=" << ring->size << " overwritten=" << ringJson["overwritten"] << '\n';
+  ShadowDamageFormula magic(std::make_unique<FaultFormula>(5), std::make_unique<FaultFormula>(0), ring);
+  Check(magic.CalculateDamage(attacker, defender, SpellCastData{}) == 17, "spell pass through changed");
+  Check(ring->hits == ShadowDamageFormula::kCapacity + 17, "magic must not enter physical buffer");
+
+  // Warm legacy record caches before timing. No JSON/log/output in timed loops.
+  for (int i = 0; i < 1000; ++i) { (void)off->CalculateDamage(attacker, defender, hit); (void)on.CalculateDamage(attacker, defender, hit); }
+  constexpr int iterations = 20000;
+  volatile double sink = 0;
+  auto bench = [&](const IDamageFormula& formula) {
+    const auto start = std::chrono::steady_clock::now();
+    for (int i = 0; i < iterations; ++i) sink = sink + formula.CalculateDamage(attacker, defender, hit);
+    return std::chrono::duration<double, std::nano>(std::chrono::steady_clock::now() - start).count() / iterations;
+  };
+  double offSum = 0, onSum = 0;
+  for (int round = 0; round < 5; ++round) {
+    const auto offNs = round % 2 ? bench(*off) : 0;
+    const auto onNs = bench(on);
+    const auto finalOffNs = round % 2 ? offNs : bench(*off);
+    offSum += finalOffNs; onSum += onNs;
+    std::cout << "BENCH round=" << round << " iterations=" << iterations
+      << " off_ns=" << finalOffNs << " shadow_ns=" << onNs << " added_ns=" << onNs - finalOffNs << '\n';
+  }
+  Check(buffer->size == ShadowDamageFormula::kCapacity && sink > 0, "benchmark/capacity check");
+  std::cout << "BENCH mean off_ns=" << offSum / 5 << " shadow_ns=" << onSum / 5
+    << " added_ns=" << (onSum - offSum) / 5 << '\n';
+  // Isolate the added work from the much slower legacy lookup path: short
+  // full-chain runs can otherwise hide sub-microsecond cost under timing noise.
+  FaultFormula fixedCurrent(5);
+  auto isolatedBuffer = std::make_shared<ShadowDamageFormula::Buffer>();
+  ShadowDamageFormula isolated(std::make_unique<FaultFormula>(5),
+    std::make_unique<aetherius::combat::AetheriusDamageFormula>(browser,
+      std::vector<aetherius::combat::StableFormKey>{
+        aetherius::combat::StableFormKey::Parse("Skyrim.esm:01397E"),
+        aetherius::combat::StableFormKey::Parse("Skyrim.esm:012E46")}), isolatedBuffer);
+  constexpr int isolatedIterations = 500000;
+  auto isolatedBench = [&](const IDamageFormula& formula) {
+    const auto start = std::chrono::steady_clock::now();
+    for (int i = 0; i < isolatedIterations; ++i)
+      sink = sink + formula.CalculateDamage(attacker, defender, hit);
+    return std::chrono::duration<double, std::nano>(std::chrono::steady_clock::now() - start).count() / isolatedIterations;
+  };
+  for (int round = 0; round < 3; ++round) {
+    const auto fixedNs = isolatedBench(fixedCurrent);
+    const auto shadowNs = isolatedBench(isolated);
+    std::cout << "ISOLATED round=" << round << " iterations=" << isolatedIterations
+      << " fixed_ns=" << fixedNs << " shadow_ns=" << shadowNs
+      << " added_ns=" << shadowNs - fixedNs << '\n';
+  }
+  std::cout << "PASS " << checks << " checks\n";
+}
+}

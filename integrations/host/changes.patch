+  template <class T, size_t N>
+  struct Ring
+  {
+    std::array<T, N> items{};
+    uint64_t total = 0;
+    size_t size = 0, next = 0;
+
+    T& Push() noexcept
+    {
+      T& slot = items[next];
+      slot = T{};
+      slot.sequence = ++total;
+      next = (next + 1) % N;
+      if (size < N) {
+        ++size;
+      }
+      return slot;
+    }
+    // Oldest to newest.
+    const T& At(size_t i) const noexcept
+    {
+      return items[(next + N - size + i) % N];
+    }
+    uint64_t Overwritten() const noexcept { return total - size; }
+  };

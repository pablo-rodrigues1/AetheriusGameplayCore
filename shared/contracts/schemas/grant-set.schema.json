{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aetherius.invalid/contracts/v1/grant-set.schema.json",
  "title": "GrantSet",
  "$ref": "#/definitions/GrantSet",
  "definitions": {
    "ProfileKey": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "CharacterKey": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "SessionEpoch": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "CatalogSignature": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "RuntimeFormId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295,
      "description": "Transient only. Never a persisted character/record key."
    },
    "ActorRef": {
      "type": "object",
      "properties": {
        "actorId": {
          "$ref": "#/definitions/RuntimeFormId"
        }
      },
      "required": [
        "actorId"
      ],
      "additionalProperties": false
    },
    "SessionBinding": {
      "type": "object",
      "properties": {
        "profileKey": {
          "$ref": "#/definitions/ProfileKey"
        },
        "characterKey": {
          "$ref": "#/definitions/CharacterKey"
        },
        "actorRef": {
          "$ref": "#/definitions/ActorRef"
        },
        "epoch": {
          "$ref": "#/definitions/SessionEpoch"
        }
      },
      "required": [
        "profileKey",
        "characterKey",
        "actorRef",
        "epoch"
      ],
      "additionalProperties": false
    },
    "PluginKind": {
      "type": "string",
      "enum": [
        "FULL",
        "LIGHT"
      ]
    },
    "StableFormKey": {
      "type": "string",
      "allOf": [
        {
          "pattern": "^[^\\x00-\\x1f\\\\/:|A-Z\\s][^\\x00-\\x1f\\\\/:|A-Z]*\\.(esm|esp|esl)\\|[0-9A-F]{6}$",
          "type": "string"
        },
        {
          "pattern": "\\|(?!000000)[0-9A-F]{6}$",
          "type": "string"
        },
        {
          "if": {
            "pattern": "\\.esl\\|",
            "type": "string"
          },
          "then": {
            "pattern": "\\|000[0-9A-F]{3}$",
            "type": "string"
          }
        }
      ],
      "description": "Canonical defining-plugin|XXXXXX. ESPFE range additionally requires catalog LIGHT metadata and codec validation."
    },
    "RecordType": {
      "type": "string",
      "enum": [
        "RACE",
        "PERK",
        "SPEL",
        "MGEF",
        "WEAP",
        "ARMO",
        "AMMO",
        "NPC_",
        "ACTI",
        "REFR",
        "KYWD",
        "ENCH",
        "ALCH",
        "LVLI"
      ]
    },
    "DefinitionRef": {
      "type": "object",
      "properties": {
        "stableFormKey": {
          "$ref": "#/definitions/StableFormKey"
        },
        "recordType": {
          "$ref": "#/definitions/RecordType"
        },
        "catalogSignature": {
          "$ref": "#/definitions/CatalogSignature"
        }
      },
      "required": [
        "stableFormKey",
        "recordType",
        "catalogSignature"
      ],
      "additionalProperties": false
    },
    "RevisionVector": {
      "type": "object",
      "properties": {
        "facts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "grants": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "equipment": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "effects": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "catalog": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "facts",
        "grants",
        "equipment",
        "effects",
        "catalog"
      ],
      "additionalProperties": false
    },
    "GrantSourceKind": {
      "type": "string",
      "enum": [
        "CLASS",
        "RACE",
        "STANDING_STONE",
        "RELIGION",
        "QUEST",
        "EQUIPMENT",
        "LEARNED",
        "ADMIN",
        "SYSTEM",
        "TRANSFORMATION"
      ]
    },
    "GrantSource": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/definitions/GrantSourceKind"
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "kind",
        "key"
      ],
      "additionalProperties": false
    },
    "EffectOwner": {
      "type": "string",
      "enum": [
        "AETHERIUS_SERVER",
        "NATIVE_SERVER",
        "NATIVE_CLIENT",
        "DISABLED"
      ]
    },
    "PerkGrant": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "perk"
        },
        "definition": {
          "allOf": [
            {
              "$ref": "#/definitions/DefinitionRef"
            },
            {
              "properties": {
                "recordType": {
                  "type": "string",
                  "enum": [
                    "PERK"
                  ]
                }
              },
              "type": "object"
            }
          ]
        },
        "source": {
          "$ref": "#/definitions/GrantSource"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        }
      },
      "required": [
        "kind",
        "definition",
        "source",
        "revision",
        "rank"
      ],
      "additionalProperties": false
    },
    "SpellGrant": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "spell"
        },
        "definition": {
          "allOf": [
            {
              "$ref": "#/definitions/DefinitionRef"
            },
            {
              "properties": {
                "recordType": {
                  "type": "string",
                  "enum": [
                    "SPEL"
                  ]
                }
              },
              "type": "object"
            }
          ]
        },
        "source": {
          "$ref": "#/definitions/GrantSource"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "kind",
        "definition",
        "source",
        "revision"
      ],
      "additionalProperties": false
    },
    "AbilityGrant": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "ability"
        },
        "definition": {
          "allOf": [
            {
              "$ref": "#/definitions/DefinitionRef"
            },
            {
              "properties": {
                "recordType": {
                  "type": "string",
                  "enum": [
                    "SPEL"
                  ]
                }
              },
              "type": "object"
            }
          ]
        },
        "source": {
          "$ref": "#/definitions/GrantSource"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "kind",
        "definition",
        "source",
        "revision"
      ],
      "additionalProperties": false
    },
    "PowerGrant": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "power"
        },
        "definition": {
          "allOf": [
            {
              "$ref": "#/definitions/DefinitionRef"
            },
            {
              "properties": {
                "recordType": {
                  "type": "string",
                  "enum": [
                    "SPEL"
                  ]
                }
              },
              "type": "object"
            }
          ]
        },
        "source": {
          "$ref": "#/definitions/GrantSource"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "kind",
        "definition",
        "source",
        "revision"
      ],
      "additionalProperties": false
    },
    "ModifierGrant": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "modifier"
        },
        "definition": {
          "$ref": "#/definitions/DefinitionRef"
        },
        "source": {
          "$ref": "#/definitions/GrantSource"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "owner": {
          "$ref": "#/definitions/EffectOwner"
        }
      },
      "required": [
        "kind",
        "definition",
        "source",
        "revision",
        "owner"
      ],
      "additionalProperties": false
    },
    "Grant": {
      "oneOf": [
        {
          "$ref": "#/definitions/PerkGrant"
        },
        {
          "$ref": "#/definitions/SpellGrant"
        },
        {
          "$ref": "#/definitions/AbilityGrant"
        },
        {
          "$ref": "#/definitions/PowerGrant"
        },
        {
          "$ref": "#/definitions/ModifierGrant"
        }
      ]
    },
    "GrantSet": {
      "type": "object",
      "properties": {
        "characterKey": {
          "$ref": "#/definitions/CharacterKey"
        },
        "revision": {
          "$ref": "#/definitions/RevisionVector"
        },
        "grants": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Grant"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "characterKey",
        "revision",
        "grants"
      ],
      "additionalProperties": false
    },
    "GrantProjection": {
      "type": "object",
      "properties": {
        "binding": {
          "$ref": "#/definitions/SessionBinding"
        },
        "set": {
          "$ref": "#/definitions/GrantSet"
        }
      },
      "required": [
        "binding",
        "set"
      ],
      "additionalProperties": false
    },
    "GrantProjectionAck": {
      "type": "object",
      "properties": {
        "binding": {
          "$ref": "#/definitions/SessionBinding"
        },
        "revision": {
          "$ref": "#/definitions/RevisionVector"
        },
        "status": {
          "type": "string",
          "enum": [
            "applied",
            "unsupported",
            "invalid"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "binding",
        "revision",
        "status",
        "reason"
      ],
      "additionalProperties": false
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/JsonValue"
          }
        },
        {
          "$ref": "#/definitions/JsonObject"
        }
      ]
    },
    "JsonObject": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/JsonValue"
      }
    },
    "CommandEnvelope": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "characterKey": {
          "$ref": "#/definitions/CharacterKey"
        },
        "epoch": {
          "$ref": "#/definitions/SessionEpoch"
        },
        "expectedRevision": {
          "$ref": "#/definitions/RevisionVector"
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "payload": {
          "$ref": "#/definitions/JsonValue"
        }
      },
      "required": [
        "requestId",
        "characterKey",
        "epoch",
        "type",
        "payload"
      ],
      "additionalProperties": false
    },
    "CommandResult": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "requestId": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "status": {
              "const": "accepted"
            },
            "revision": {
              "$ref": "#/definitions/RevisionVector"
            }
          },
          "required": [
            "requestId",
            "reason",
            "status",
            "revision"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "requestId": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "status": {
              "const": "rejected"
            }
          },
          "required": [
            "requestId",
            "reason",
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "requestId": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "status": {
              "const": "conflict"
            },
            "actualRevision": {
              "$ref": "#/definitions/RevisionVector"
            }
          },
          "required": [
            "requestId",
            "reason",
            "status",
            "actualRevision"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "requestId": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "status": {
              "const": "pending"
            }
          },
          "required": [
            "requestId",
            "reason",
            "status"
          ],
          "additionalProperties": false
        }
      ]
    },
    "EventEnvelope": {
      "type": "object",
      "properties": {
        "eventId": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "producer": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "payload": {
          "$ref": "#/definitions/JsonValue"
        }
      },
      "required": [
        "eventId",
        "producer",
        "version",
        "type",
        "payload"
      ],
      "additionalProperties": false
    },
    "CapabilityStatus": {
      "type": "string",
      "enum": [
        "SUPPORTED",
        "PARTIAL",
        "UNSUPPORTED",
        "DEGRADED"
      ]
    },
    "Capability": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "status": {
          "$ref": "#/definitions/CapabilityStatus"
        },
        "proof": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "required": [
        "id",
        "version",
        "status",
        "proof",
        "limitations"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "SUPPORTED"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "proof": {
                "minItems": 1,
                "type": "array"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "PARTIAL",
                  "UNSUPPORTED",
                  "DEGRADED"
                ]
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "limitations": {
                "minItems": 1,
                "type": "array"
              }
            },
            "type": "object"
          }
        }
      ]
    },
    "FeatureMode": {
      "type": "string",
      "enum": [
        "off",
        "audit",
        "shadow",
        "canary",
        "active"
      ]
    },
    "ConditionResult": {
      "type": "string",
      "enum": [
        "TRUE",
        "FALSE",
        "UNSUPPORTED",
        "INVALID"
      ]
    },
    "CatalogEntry": {
      "type": "object",
      "properties": {
        "definition": {
          "$ref": "#/definitions/DefinitionRef"
        },
        "winnerPlugin": {
          "type": "string",
          "pattern": "^[^\\x00-\\x1f\\\\/:|A-Z\\s][^\\x00-\\x1f\\\\/:|A-Z]*\\.(esm|esp|esl)$"
        },
        "pluginKind": {
          "$ref": "#/definitions/PluginKind"
        },
        "data": {
          "$ref": "#/definitions/JsonObject"
        }
      },
      "required": [
        "definition",
        "winnerPlugin",
        "pluginKind",
        "data"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "pluginKind": {
                "const": "LIGHT"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "definition": {
                "type": "object",
                "properties": {
                  "stableFormKey": {
                    "pattern": "\\|000[0-9A-F]{3}$",
                    "type": "string"
                  }
                }
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "definition": {
                "type": "object",
                "properties": {
                  "stableFormKey": {
                    "pattern": "\\.esl\\|",
                    "type": "string"
                  }
                }
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "pluginKind": {
                "const": "LIGHT"
              }
            },
            "type": "object"
          }
        }
      ]
    },
    "ProjectionReceipt": {
      "type": "object",
      "properties": {
        "binding": {
          "$ref": "#/definitions/SessionBinding"
        },
        "revision": {
          "$ref": "#/definitions/RevisionVector"
        }
      },
      "required": [
        "binding",
        "revision"
      ],
      "additionalProperties": false
    },
    "Resource": {
      "type": "string",
      "enum": [
        "health",
        "magicka",
        "stamina"
      ]
    },
    "ResourceValue": {
      "type": "object",
      "properties": {
        "resource": {
          "$ref": "#/definitions/Resource"
        },
        "current": {
          "type": "number",
          "minimum": 0
        },
        "maximum": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "resource",
        "current",
        "maximum"
      ],
      "additionalProperties": false
    },
    "ResourceSnapshot": {
      "type": "object",
      "properties": {
        "binding": {
          "$ref": "#/definitions/SessionBinding"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "values": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ResourceValue"
          },
          "minItems": 3,
          "maxItems": 3,
          "allOf": [
            {
              "contains": {
                "type": "object",
                "properties": {
                  "resource": {
                    "const": "health"
                  }
                },
                "required": [
                  "resource"
                ]
              },
              "type": "array"
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "resource": {
                    "const": "magicka"
                  }
                },
                "required": [
                  "resource"
                ]
              },
              "type": "array"
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "resource": {
                    "const": "stamina"
                  }
                },
                "required": [
                  "resource"
                ]
              },
              "type": "array"
            }
          ]
        }
      },
      "required": [
        "binding",
        "revision",
        "values"
      ],
      "additionalProperties": false
    },
    "ResourceMutation": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "binding": {
          "$ref": "#/definitions/SessionBinding"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "resource": {
          "$ref": "#/definitions/Resource"
        },
        "delta": {
          "type": "number"
        }
      },
      "required": [
        "requestId",
        "binding",
        "expectedRevision",
        "resource",
        "delta"
      ],
      "additionalProperties": false
    },
    "ResourceMutationReceipt": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "binding": {
          "$ref": "#/definitions/SessionBinding"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "requestId",
        "binding",
        "revision"
      ],
      "additionalProperties": false
    },
    "ClientHitEvidence": {
      "type": "object",
      "properties": {
        "trust": {
          "const": "CLIENT_EVIDENCE"
        },
        "binding": {
          "$ref": "#/definitions/SessionBinding"
        },
        "occurrenceId": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "aggressor": {
          "$ref": "#/definitions/ActorRef"
        },
        "target": {
          "$ref": "#/definitions/ActorRef"
        },
        "source": {
          "$ref": "#/definitions/RuntimeFormId"
        },
        "projectile": {
          "anyOf": [
            {
              "$ref": "#/definitions/RuntimeFormId"
            },
            {
              "type": "null"
            }
          ]
        },
        "flags": {
          "type": "object",
          "properties": {
            "power": {
              "type": "boolean"
            },
            "sneak": {
